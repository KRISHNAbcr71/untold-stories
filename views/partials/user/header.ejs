<!-- BEGIN: NavigationHeader -->
<header class="w-full bg-[#FAF7F0] border-b border-[#EFE9DD] sticky top-0 z-50 transition-all">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">
    <!-- Logo Branding -->
    <a class="flex items-center gap-3 group" href="#">
      <div
        class="w-9 h-9 rounded-full border border-stone-400/60 flex items-center justify-center p-1.5 transition-transform group-hover:scale-105">
        <svg class="w-full h-full text-stone-800" fill="none" stroke="currentColor" stroke-linecap="round"
          stroke-linejoin="round" stroke-width="1.6" viewbox="0 0 24 24">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
          <path d="M6 6h10"></path>
          <path d="M6 10h10"></path>
          <path d="M6 14h6"></path>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-literary text-2xl font-bold tracking-tight text-ink-900 leading-tight">The Untold
          Stories</span>
        <span class="text-[9px] uppercase tracking-[0.22em] text-[#b4653b] font-semibold mt-1">Rare Editions &amp;
          Literary Archive</span>
      </div>
    </a>
    <!-- Primary Navigation Links -->
    <nav class="hidden md:flex items-center gap-8 text-[13px] tracking-wide font-medium">
      <a class="text-ink-900 relative py-1 font-semibold after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-[#C25E34]"
        href="/">Home</a>
      <a class="text-stone-600 hover:text-ink-900 transition-colors py-1" href="#">Shop</a>
    </nav>
    <!-- User Actions & Cart -->
    <div class="flex items-center gap-5">
      <!-- Wishlist Icon -->
      <button aria-label="Wishlist" class="text-stone-700 hover:text-ink-900 p-1.5 transition-colors" type="button">
        <svg class="w-5 h-5 stroke-[1.6]" fill="none" stroke="currentColor" viewbox="0 0 24 24">
          <path
            d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
            stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <!-- Cart Bag with Badge -->
      <button aria-label="Shopping Bag" class="text-stone-700 hover:text-ink-900 p-1.5 relative transition-colors"
        type="button">
        <svg class="w-5 h-5 stroke-[1.6]" fill="none" stroke="currentColor" viewbox="0 0 24 24">
          <path
            d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25c-.67 0-1.19-.578-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
            stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span
          class="absolute -top-1 -right-1 text-[10px] w-4 h-4 rounded-full bg-stone-100 border border-stone-300 text-stone-800 font-semibold flex items-center justify-center">0</span>
      </button>
      <div class="h-4 w-[1px] bg-stone-300 hidden sm:block"></div>
      <!-- Auth Buttons -->
      <% if(currentUser) {%>

        <div class="relative group">
          <button type="button"
            class="text-xs font-semibold tracking-wider text-stone-700 hover:text-ink-900 px-2 py-1 flex items-center gap-2">
            <%= currentUser.name %>

              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
              </svg>
          </button>

          <div class="absolute right-0 top-full pt-2 w-40 hidden group-hover:block group-focus-within:block">
            <div class="bg-[#FAF7F0] border border-[#EFE9DD] shadow-md rounded-sm py-2">
              <a href="/account" class="block px-4 py-2 text-xs text-stone-700 hover:bg-[#EFE9DD]">
                Account
              </a>

              <form action="/logout" method="POST">
                <button type="submit" class="w-full text-left px-4 py-2 text-xs text-stone-700 hover:bg-[#EFE9DD]">
                  Logout
                </button>
              </form>
            </div>
          </div>
        </div>

        <%}else{%>
          <a class="text-xs font-semibold uppercase tracking-wider text-stone-700 hover:text-ink-900 px-2 py-1"
            href="/login">LOGIN</a>
          <a class="text-xs font-medium uppercase tracking-wider bg-stone-900 text-white hover:bg-stone-800 px-4 py-2 rounded-sm transition-all shadow-sm"
            href="/signup">SIGN UP</a>
          <%}%>
    </div>
  </div>
</header>
<!-- END: NavigationHeader -->
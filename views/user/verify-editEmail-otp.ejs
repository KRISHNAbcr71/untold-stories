<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Verify Your New Email — The Untold Stories</title>
    <!-- Tailwind CSS v3 -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Google Fonts for Editorial Serif and Clean Sans -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&amp;family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        serif: ['Newsreader', 'Georgia', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
                        display: ['Cinzel', 'serif']
                    },
                    colors: {
                        archival: {
                            bg: '#faf7f5',
                            surface: '#ffffff',
                            card: '#ffffff',
                            input: '#f4ede6',
                            accent: '#92400e',
                            terracotta: '#9f4827',
                            terracottaHover: '#873d20',
                            charcoal: '#1d1917',
                            muted: '#78716c',
                            border: '#e7ded6',
                            badge: '#eee8e2'
                        }
                    }
                }
            }
        }
    </script>
    <style data-purpose="base-typography">
        body {
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            background-color: #faf7f5;
            color: #1d1917;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .font-newsreader {
            font-family: 'Newsreader', Georgia, serif;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col justify-between bg-[#faf7f5] text-[#1d1917]">
    <%- include('../partials/user/header')%>
    <!-- BEGIN: MainContent -->
    <main class="flex-grow flex flex-col items-center justify-start pt-8 pb-16 px-4"
        data-purpose="otp-verification-flow">
        <div class="w-full max-w-[624px]">
            <!-- Breadcrumb Navigation -->
            <div class="flex items-center justify-between mb-5 self-start">
                <div class="flex items-center gap-2 text-[11px] font-semibold tracking-wider uppercase text-[#78716A]">
                    <a class="text-[#4A4641] hover:text-black cursor-pointer flex items-center gap-1.5 transition-colors"
                        href="/profile/editEmail">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-linecap="round"
                            stroke-linejoin="round" stroke-width="2.5" viewBox="0 0 24 24">
                            <path d="M10.5 19.5 3 12m0 0l7.5-7.5M3 12h18"></path>
                        </svg>
                        EDIT EMAIL
                    </a>
                    <span class="text-[#9C948B]">/</span>
                    <span class="text-[#9f4827] font-bold">
                        <%= pageTitle%>
                    </span>
                </div>
            </div>
            <!-- Verification Card Container -->
            <div class="w-full max-w-xl bg-white/70 backdrop-blur-sm border border-[#e8dfd5] rounded-sm shadow-[0_4px_24px_rgba(0,0,0,0.03)] p-8 sm:p-10"
                data-purpose="otp-card">
                <!-- Security Badge Tag -->
                <div class="mb-5">
                    <span
                        class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#ede6df] text-[#44403c] rounded text-[11px] font-semibold tracking-wider uppercase">
                        <svg class="w-3.5 h-3.5 text-[#57534e]" fill="none" stroke="currentColor" stroke-width="2"
                            viewbox="0 0 24 24">
                            <rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        Encrypted Transit • 1 Min Validity
                    </span>
                </div>
                <!-- Title -->
                <h1 class="font-newsreader text-[38px] sm:text-[42px] leading-tight text-[#1c1917] font-normal mb-3">
                    Verify Your New Email
                </h1>
                <!-- Informative Subtext & Email -->
                <p class="text-[14px] leading-relaxed text-[#57534e] mb-1">
                    We have dispatched a confidential 6–digit verification code to your intended archival dispatch address:
                </p>
                <p class="text-[14px] mb-7">
                    <span class="font-bold text-[#1c1917]"><%= email %></span>
                </p>
                <!-- OTP Inputs Section -->
                <div class="mb-6">
                    <label class="block text-[11px] uppercase tracking-[0.18em] font-bold text-[#57534e] mb-3">
                        Passcode Digits
                    </label>
                    
                    <!-- 6 Code Input Slots -->
                    <div class="grid grid-cols-6 gap-2.5 sm:gap-3"
                        id="otpInputs">

                        <input type="text" maxlength="1" inputmode="numeric" autocomplete="one-time-code"
                            class="w-full h-16 bg-[#f3ede6] rounded text-center font-newsreader text-2xl text-[#1c1917] border border-transparent focus:border-[#9f4827] focus:outline-none">

                        <input type="text" maxlength="1" inputmode="numeric"
                            class="w-full h-16 bg-[#f3ede6] rounded text-center font-newsreader text-2xl text-[#1c1917] border border-transparent focus:border-[#9f4827] focus:outline-none">

                        <input type="text" maxlength="1" inputmode="numeric"
                            class="w-full h-16 bg-[#f3ede6] rounded text-center font-newsreader text-2xl text-[#1c1917] border border-transparent focus:border-[#9f4827] focus:outline-none">

                        <input type="text" maxlength="1" inputmode="numeric"
                            class="w-full h-16 bg-[#f3ede6] rounded text-center font-newsreader text-2xl text-[#1c1917] border border-transparent focus:border-[#9f4827] focus:outline-none">

                        <input type="text" maxlength="1" inputmode="numeric"
                            class="w-full h-16 bg-[#f3ede6] rounded text-center font-newsreader text-2xl text-[#1c1917] border border-transparent focus:border-[#9f4827] focus:outline-none">

                        <input type="text" maxlength="1" inputmode="numeric"
                            class="w-full h-16 bg-[#f3ede6] rounded text-center font-newsreader text-2xl text-[#1c1917] border border-transparent focus:border-[#9f4827] focus:outline-none">

                    </div>

                </div>
                <!-- Expiry Status and Resend Button -->
                <div class="mb-7">
                    <div class="flex items-center justify-between text-[13px] text-[#57534e] mb-2">
                        <div class="flex items-center gap-1.5 font-medium">
                            <svg class="w-4 h-4 text-[#9f4827]" fill="none" stroke="currentColor" stroke-width="2"
                                viewbox="0 0 24 24">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>Code expires in 
                                <span id="otpTimer" class="font-semibold text-[#1c1917]">01:00</span> 
                                <!-- <span id="otp-expired" class="text-[#78716c] font-normal hidden">(Expired)</span> -->
                            </span>
                        </div>
                        <button
                            class="inline-flex items-center gap-1 text-[12px] font-bold tracking-wider uppercase text-[#9f4827] hover:text-[#80381d] transition-colors"
                            type="button"
                            disabled
                            id="resendOtp">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2"
                                viewbox="0 0 24 24">
                                <path
                                    d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
                                    stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg>
                            Resend OTP
                        </button>
                    </div>
                    <!-- Progress Indicator Track with Expired status bar -->
                    <div class="w-full bg-[#e7ded5] h-[3px] rounded-full overflow-hidden">
                        <div class="bg-[#9f4827] h-full w-[48%] rounded-full"></div>
                    </div>
                </div>
                <!-- Actions: Verify & Cancel Buttons -->
                <div class="grid grid-cols-1 sm:grid-cols-5 gap-3 mb-7" data-purpose="form-actions">
                    <button
                        class="sm:col-span-2 w-full bg-[#ede6df] hover:bg-[#e4dbd2] text-[#292524] py-3.5 px-4 rounded-sm text-[12px] uppercase font-bold tracking-[0.12em] transition-colors"
                        type="button"
                        onclick="window.location.href='/profile/editEmail'">
                        Cancel &amp; Return
                    </button>
                    <button
                        class="sm:col-span-3 w-full bg-[#181514] hover:bg-[#2b2725] text-white py-3.5 px-4 rounded-sm flex items-center justify-center gap-2 text-[12px] uppercase font-bold tracking-[0.14em] transition-colors shadow-sm"
                        type="button"
                        id="verifyEmailOtp">
                        <span>Verify &amp; Update Email</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewbox="0 0 24 24">
                            <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" stroke-linecap="round" stroke-linejoin="round">
                            </path>
                        </svg>
                    </button>
                </div>
                <!-- What Happens Next Notice Box -->
                <div class="bg-[#f8f5f0] border border-[#e8dfd5] rounded p-4 flex items-start gap-3.5"
                    data-purpose="informational-banner">
                    <div class="mt-0.5 text-[#9f4827] flex-shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewbox="0 0 24 24">
                            <path
                                d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
                                stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-[11px] uppercase tracking-[0.16em] font-bold text-[#1c1917] mb-1">
                            What Happens Next
                        </h2>
                        <p class="text-[12.5px] leading-relaxed text-[#57534e]">
                            Once verified, your account and all notifications, orders, and certificates will immediately
                            switch to this new email address.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <!-- END: MainContent -->
    <%- include('../partials/user/footer') %>
</body>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    const otpContainer = document.getElementById('otpInputs')
    const otpInputs = otpContainer.querySelectorAll('input')

    otpInputs.forEach((input, index) => {

        // Accept only one numeric digit
        input.addEventListener('input', () => {
            input.value = input.value.replace(/\D/g, '').slice(0, 1)

            if (input.value && index < otpInputs.length - 1) {
                otpInputs[index + 1].focus()
            }
        })

        // Move backwards using Backspace
        input.addEventListener('keydown', (event) => {
            if (event.key === 'Backspace' && !input.value && index > 0) {
                otpInputs[index - 1].focus()
            }
        })

    })




    // otp validation
    const verifyEmailOtp = document.getElementById('verifyEmailOtp')

    verifyEmailOtp.addEventListener('click', async() => {

        const otpInputs = document.querySelectorAll('#otpInputs input')

        let otp = ''

        otpInputs.forEach((input) => {
            otp += input.value.trim()
        })

        if (!/^\d{6}$/.test(otp)) {
            Swal.fire({
                icon: 'warning',
                title: 'Incomplete OTP',
                text: 'Please enter the complete 6-digit verification code.',
                confirmButtonText: 'OK',
                confirmButtonColor: '#9f4827'
            })

            return
        }

        try {
            const response = await fetch('/profile/verifyEmailOtp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ otp: otp })
            })

            const result = await response.json()

            if (!response.ok) {
                await Swal.fire({
                    icon: 'error',
                    title: 'Verification Failed!',
                    text: result.message,
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#9f4827'
                })

                return
            }

            await Swal.fire({
                icon: 'success',
                title: 'Email Updated!',
                text: result.message,
                confirmButtonText: 'Continue',
                confirmButtonColor: '#9f4827'
            })

            window.location.href = '/profile'

        } catch (error) {
            console.error('Email OTP verification error:', error)

            Swal.fire({
                icon: 'error',
                title: 'Something Went Wrong!',
                text: 'Unable to verify your email. Please try again.',
                confirmButtonText: 'OK',
                confirmButtonColor: '#9f4827'
            })
        }

    })





    // send otp
    const otpTimer = document.getElementById('otpTimer')
    const resendOtp = document.getElementById('resendOtp')

    let otpExpiresAt = <%= otpExpiresAt %>
    let countdown

    function startCountdown() {
        clearInterval(countdown)

        function updateTimer() {
            const timeLeft = Math.max(0, Math.ceil((otpExpiresAt - Date.now()) / 1000))

            const minutes = Math.floor(timeLeft / 60)
            const seconds = timeLeft % 60

            otpTimer.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`

            if (timeLeft <= 0) {
                clearInterval(countdown)
                otpTimer.textContent = 'Expired'

                resendOtp.disabled = false
                resendOtp.classList.remove('opacity-50', 'cursor-not-allowed')
                return
            }

            resendOtp.disabled = true
            resendOtp.classList.add('opacity-50', 'cursor-not-allowed')
        }

        updateTimer()
        countdown = setInterval(updateTimer, 1000)
    }

    startCountdown()






    // Resend OTP
    resendOtp.addEventListener('click', async () => {
        try {
            const response = await fetch('/profile/resendEmailOtp', {
                method: 'POST'
            })

            const result = await response.json()

            if (!response.ok) {
                Swal.fire({
                    icon: 'error',
                    title: 'Unable to Resend OTP!',
                    text: result.message,
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#9f4827'
                })

                return
            }

            // Update expiry time and restart countdown
            otpExpiresAt = Number(result.otpExpiresAt)
            startCountdown()

            // Clear previous OTP digits
            otpInputs.forEach((input) => {
                input.value = ''
            })

            otpInputs[0].focus()

            await Swal.fire({
                icon: 'success',
                title: 'OTP Sent Successfully!',
                text: result.message,
                confirmButtonText: 'OK',
                confirmButtonColor: '#9f4827'
            })

        } catch (error) {
            console.error('Resend OTP error:', error)

            Swal.fire({
                icon: 'error',
                title: 'Something Went Wrong!',
                text: 'Unable to resend OTP. Please try again.',
                confirmButtonText: 'OK',
                confirmButtonColor: '#9f4827'
            })
        }
    })


</script>

</html>
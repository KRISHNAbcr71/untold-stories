<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Edit Inscribed Name — The Untold Stories</title>
  <!-- Tailwind CSS v3 with forms and container queries -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <!-- Google Fonts: Cormorant Garamond & Plus Jakarta Sans -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700&amp;display=swap"
    rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            parchment: {
              50: '#fbf9f6',
              100: '#f6f3ee',
              200: '#ede8e1',
              300: '#e1d9ce',
            },
            archival: {
              base: '#1b1a18',
              card: '#ffffff',
              muted: '#68645e',
              border: '#eae6df',
              accent: '#a85b3b'
            }
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style data-purpose="custom-styling">
    body {
      background-color: #fbf9f6;
      color: #1b1a18;
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    }

    .font-serif-heading {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }
  </style>
</head>

<body class="min-h-screen flex flex-col justify-between text-[#24211d] bg-[#fbf9f6]">
  <%- include('../partials/user/header')%>
  <!-- BEGIN: MainContent -->
  <main class="flex-grow flex flex-col items-center justify-start pt-10 pb-20 px-4" data-purpose="page-body">
    <div class="w-full max-w-[620px]">
      <!-- Breadcrumb / Back Link -->
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-2 text-[0.72rem] font-semibold tracking-wider uppercase text-[#857d74]">
          <a href="/profile">
          <span class="text-[#555047] cursor-pointer hover:underline flex items-center gap-1.5">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            PROFILE
          </span>
          </a>
          <span class="text-[#b5ada3]">/</span>
          <span class="text-[#965b38] font-bold"><%= pageTitle %></span>
        </div>
      </div>
      <!-- Main Edit Card -->
      <div
        class="relative bg-white rounded-lg shadow-[0_4px_25px_-5px_rgba(0,0,0,0.05),0_1px_3px_rgba(0,0,0,0.03)] border border-[#ede9e3] p-8 md:p-10 overflow-hidden"
        data-purpose="edit-name-form-card">
        <!-- Watermark / Decorative Archival Seal on top right -->
        <div class="absolute -top-3 -right-3 opacity-[0.06] pointer-events-none select-none">
          <svg fill="none" height="150" stroke="#000000" stroke-width="1.2" viewBox="0 0 100 100" width="150">
            <circle cx="50" cy="50" r="44"></circle>
            <circle cx="50" cy="50" r="38" stroke-dasharray="2 3"></circle>
            <path d="M50 15 L50 85 M15 50 L85 50"></path>
            <path d="M25 25 L75 75 M25 75 L75 25"></path>
            <rect height="30" width="30" x="35" y="35"></rect>
          </svg>
        </div>
        <!-- Form Title & Description -->
        <div class="relative z-10 mb-7">
          <h1 class="font-serif-heading text-[2.1rem] leading-tight font-medium text-[#191816] tracking-normal mb-2.5">
            Edit Inscribed Name
          </h1>
          <p class="text-[0.86rem] text-[#635d55] font-normal leading-relaxed">
            View your current registered name below and enter your new name to update your account details.
          </p>
        </div>
        <!-- Form Container -->
        <form id="edit-name-form" class="space-y-6 relative z-10" novalidate>
          <!-- CURRENT REGISTERED NAME (Read-Only) -->
          <div data-purpose="current-name-group">
            <div class="flex items-center justify-between mb-2">
              <label class="text-[0.67rem] font-bold tracking-[0.08em] uppercase text-[#332f2a]">
                CURRENT REGISTERED NAME
              </label>
              <!-- Archived Badge -->
              <span
                class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[0.64rem] font-medium tracking-wider text-[#635f58] bg-[#f0ede6]">
                <svg class="w-2.5 h-2.5 opacity-70" fill="none" stroke="currentColor" stroke-width="2"
                  viewBox="0 0 24 24">
                  <rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                ARCHIVED • READ-ONLY
              </span>
            </div>
            <!-- Input / Display Field -->
            <div
              class="w-full bg-[#f6f2ec] border border-[#e8e2d8] rounded flex items-center justify-between px-3.5 py-2.5 text-[#302c27]">
              <div class="flex items-center space-x-2.5">
                <!-- Shield Icon -->
                <svg class="w-4 h-4 text-[#8a8379] stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"
                    stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span class="font-serif-heading text-[1.12rem] font-normal text-[#211f1d] tracking-wide">
                  <%= user.name %>
                </span>
              </div>
              <!-- Lock Icon -->
              <svg class="w-3.5 h-3.5 text-[#8a8379]" fill="none" stroke="currentColor" stroke-width="2"
                viewBox="0 0 24 24">
                <rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <!-- Information Alert text -->
            <div class="flex items-start space-x-1.5 mt-2 text-[0.74rem] text-[#827a71] leading-normal">
              <svg class="w-3.5 h-3.5 text-[#9e7654] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor"
                stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" x2="12" y1="16" y2="12"></line>
                <line x1="12" x2="12.01" y1="8" y2="8"></line>
              </svg>
              <span>Your current name cannot be edited directly because it is linked to your existing orders and
                records.</span>
            </div>
          </div>
          <!-- NEW INSCRIBED NAME -->
          <div data-purpose="new-name-group">
            <div class="mb-2">
              <label class="text-[0.67rem] font-bold tracking-[0.08em] uppercase text-[#332f2a]" for="inscribed-name">
                NEW INSCRIBED NAME <span class="text-[#b85d38] font-bold">*</span>
              </label>
            </div>
            <!-- Text Input with Pen Icon -->
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-[#a88261] pointer-events-none">
                <!-- Nib / Fountain pen calligraphy icon -->
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z">
                  </path>
                </svg>
              </span>
              <input
                class="w-full bg-[#fdfbf7] border border-[#e8dfd5] focus:border-[#4a4640] focus:ring-1 focus:ring-[#4a4640] rounded pl-10 pr-3.5 py-2.5 text-[0.98rem] font-serif-heading text-[#211f1d] placeholder:text-[#a8a096] placeholder:font-sans placeholder:text-[0.88rem] transition-colors"
                id="name" 
                placeholder="Enter Your Name" 
                type="text"
                name="name"
                required>
              
            </div>
            <p id="nameError" class="text-red-600 text-xs mt-1"></p>
            <!-- Footnote description -->
            <p class="text-[0.74rem] text-[#827a71] mt-2 leading-relaxed">
              This new name will be used on your certificates, account records, and future delivery orders.
            </p>
          </div>
          <!-- Form Buttons -->
          <div class="pt-4 flex items-center justify-end space-x-3" data-purpose="form-actions">
            <button
              class="px-5 py-2 rounded text-[0.72rem] font-bold uppercase tracking-wider text-[#35312d] bg-[#ece7df] hover:bg-[#e2dcd2] transition-colors"
              type="button"
              onclick="window.location.href='/profile'">
              CANCEL &amp; RETURN
            </button>
            <button
              class="px-5 py-2 rounded text-[0.72rem] font-bold uppercase tracking-wider text-white bg-[#1b1a18] hover:bg-[#2f2c27] flex items-center space-x-1.5 transition-colors shadow-sm"
              type="submit">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
              </svg>
              <span>UPDATE NAME</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
  <!-- END: MainContent -->
  <%- include('../partials/user/footer')%>


</body>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  const editNameForm = document.getElementById('edit-name-form')
  editNameForm.addEventListener('submit',async(event)=>{
    event.preventDefault()

    const name = document.getElementById('name').value.trim()
    const nameError = document.getElementById('nameError')
    const currentName = '<%= user.name %>'

    if(name === ''){
      nameError.textContent = 'Name is required'
      return
    }else if(name === currentName.trim()){
      nameError.textContent = 'This is already your current name'
      return
    }else{
      nameError.textContent = ''
    }

    try {
      const response = await fetch('/profile/editName',{
        method:'PATCH',
        headers:{
          'Content-Type':'application/json'
        },
        body:JSON.stringify({name:name})
      })

      const result = await response.json()

      if(result.success){
        await Swal.fire({
          icon: 'success',
          title: 'Success!',
          text: result.message
        })
        window.location.href = '/profile'
      }else{
        await Swal.fire({
          icon: 'error',
          title: 'Update Failed',
          text: result.message
        })
      }
      
    } catch (error) {
      console.error('Name update error:', error)

      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'Something went wrong. Please try again.'
      })
    }

  })

</script>

</html>
                <h4 class="font-serif-book text-base font-bold text-[#201C18] mt-1 leading-snug">
                  <%= relatedProduct.productName %></h4>
                <p class="text-xs text-[#70665B] mt-0.5"><%= relatedProduct.author %></p>
                <div class="flex items-center text-xs text-[#C48C38] mt-2">
                  <span class="">★</span>
                  <span class="text-[#201C18] font-semibold ml-1 text-[11px]">4.8</span>
                </div>
              </div>
              <div class="flex items-center justify-between mt-4 pt-3 border-t border-[#EDE6DC]">
                <span class="font-serif-book font-bold text-base text-[#1E1916]">₹<%= relatedProduct.price.toLocaleString('en-IN') %></span>
                <button
                  class="bg-[#1C1815] text-white hover:bg-stone-800 text-[11px] font-medium px-3 py-1.5 rounded-[2px] flex items-center space-x-1">

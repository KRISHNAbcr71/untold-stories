                  <span class="">ADD</span>
                </button>
              </div>
            </div>
          </article>
          <%})%>
        </div>
      </section>
      <%}%>
      <!-- END: RelatedProductsSection -->
    </main>
    <!-- END: ProductDetailMainSection -->
    <%- include('../partials/user/footer') %>
    <script src="/js/user.js"></script>
</body>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // select thumbnail images
  const mainProductImage = document.getElementById('mainProductImage')
  const thumbnailButtons = document.querySelectorAll('[data-image]')
  thumbnailButtons.forEach(button => {
    button.addEventListener('click', () => {
      const selectedImage = button.dataset.image
      mainProductImage.src = selectedImage

      thumbnailButtons.forEach(thumbnail => {
        thumbnail.classList.remove('border-2', 'border-[#1E1A17]')
        thumbnail.classList.add('border', 'border-[#DDD6CC]')
      })

      button.classList.remove('border', 'border-[#DDD6CC]')
      button.classList.add('border-2', 'border-[#1E1A17]')

    })
  })




  let isDragging = false
  let hasDragged = false

  let startX = 0
  let startY = 0

  let imageX = 0
  let imageY = 0




  // Zoom modal opening
  const zoomProductImage = document.getElementById('zoomProductImage')
  const productZoomModal = document.getElementById('productZoomModal')
  const zoomedProductImage = document.getElementById('zoomedProductImage')
  zoomProductImage.addEventListener('click',()=>{
    zoomedProductImage.src = mainProductImage.src

    zoomedProductImage.classList.remove('scale-150')
    zoomedProductImage.classList.add('cursor-zoom-in')

    imageX = 0
    imageY = 0
    zoomedProductImage.style.translate = '0px 0px'

    isDragging = false
    hasDragged = false

    productZoomModal.classList.remove('hidden')
  })



  // zoom in and out
  zoomedProductImage.addEventListener('click',()=>{
    if(hasDragged){
      hasDragged = false
      return
    }
    const isZoomed = zoomedProductImage.classList.contains('scale-150')
    if(isZoomed){
      zoomedProductImage.classList.remove('scale-150')
      zoomedProductImage.classList.add('cursor-zoom-in')

      imageX = 0
      imageY = 0
      zoomedProductImage.style.translate = '0px 0px'
    }else{
      zoomedProductImage.classList.add('scale-150')
      zoomedProductImage.classList.remove('cursor-zoom-in')
    }
  })

  // start dragging
  zoomedProductImage.addEventListener('pointerdown',(event)=>{
    if(!zoomedProductImage.classList.contains('scale-150')){
      return
    }
    isDragging = true 
    hasDragged = false

    startX = event.clientX - imageX
    startY = event.clientY - imageY

    zoomedProductImage.setPointerCapture(event.pointerId)
  })

  // move image
  zoomedProductImage.addEventListener('pointermove',(event)=>{
    if(!isDragging){
      return
    }

    imageX = event.clientX - startX
    imageY = event.clientY - startY

    zoomedProductImage.style.translate = `${imageX}px ${imageY}px`
    hasDragged = true
  })

  // stop dragging
  zoomedProductImage.addEventListener('pointerup',()=>{
    isDragging = false
  })

  zoomedProductImage.addEventListener('pointercancel',()=>{
    isDragging = false
  })










  // Close the modal when clicking x button
  const closeProductZoom = document.getElementById('closeProductZoom')
  closeProductZoom.addEventListener('click',()=>{
    productZoomModal.classList.add('hidden')
  })

  // Close the modal when clicking the dark background
  productZoomModal.addEventListener('click',(event)=>{
    if(event.target === productZoomModal){
      productZoomModal.classList.add('hidden')
    }
  })




</script>



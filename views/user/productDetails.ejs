                    stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
              <h4 class="text-[11px] font-bold tracking-wider uppercase text-[#29221C]">CASH ON DELIVERY</h4>
              <p class="text-[11px] text-[#6E6357] leading-relaxed mt-1">Pay conveniently at your doorstep upon vaulted

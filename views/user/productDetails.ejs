<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>The Untold Stories | The Architecture of Solitude</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <!-- Google Fonts: Playfair Display & Inter / Newsreader style serif -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&amp;family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&amp;family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700&amp;display=swap"
    rel="stylesheet">
  <!-- Tailwind Configuration -->
  <script data-purpose="tailwind-config">
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            parchment: '#FAF8F5',
            'parchment-light': '#FDFCFB',
            'parchment-deep': '#F3EFEA',
            antique: {
              50: '#FDFCF7',
              100: '#F7F4EB',
              200: '#EEE7D7',
              300: '#E1D5BD',
              800: '#4A3E31',
              900: '#2A241E'
            },
            cognac: {
              600: '#9E5B32',
              700: '#8A4A24',
              800: '#733C1B'
            },
            sage: {
              700: '#2F6146',
              800: '#234934'
            }
          },
          fontFamily: {
            serif: ['Playfair Display', 'Newsreader', 'Georgia', 'serif'],
            display: ['Cinzel', 'Playfair Display', 'serif'],
            sans: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
            reader: ['Newsreader', 'Georgia', 'serif']
          }
        }
      }
    };
  </script>
  <!-- Custom CSS for specific archival styling -->
  <style data-purpose="base-styling">
    body {
      background-color: #FAF8F5;
      color: #26211E;
      font-family: 'Plus Jakarta Sans', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .font-serif-book {
      font-family: 'Playfair Display', Georgia, serif;
    }

    .tracking-widest-sub {
      letter-spacing: 0.18em;
    }
  </style>
</head>

<body class="min-h-screen bg-[#FAF8F5] text-[#24201D] flex flex-col">
  <%- include('../partials/user/header')%>
    <!-- BEGIN: BreadcrumbNavigation -->
    <nav aria-label="Breadcrumb" class="max-w-[1440px] mx-auto w-full px-6 lg:px-12 pt-6 pb-2">
      <ol class="flex items-center space-x-2 text-[12.5px] text-[#7E746A]">
        <li><a class="hover:text-black transition-colors" href="/">Home</a></li>
        <li class="text-[#B9B0A5]">/</li>

        <li><a class="hover:text-black transition-colors" href="/shop">Catalog</a></li>
        <li class="text-[#B9B0A5]">/</li>

        <li><a class="hover:text-black transition-colors" href="/shop?category=<%= product.category._id %> ">
            <%= product.category.name %>
          </a></li>
        <li class="text-[#B9B0A5]">/</li>

        <li aria-current="page" class="text-[#201D1A] font-medium">
          <%= product.productName %>
        </li>
      </ol>
    </nav>
    <!-- END: BreadcrumbNavigation -->
    <!-- BEGIN: ProductDetailMainSection -->
    <main class="max-w-[1440px] mx-auto w-full px-6 lg:px-12 pt-4 pb-16 flex-1">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">

        <!-- LEFT COLUMN: Folio Visual Inspection & Plates Gallery -->
        <section class="lg:col-span-6 flex flex-col space-y-4" data-purpose="product-gallery">
          <!-- Primary Inspection Viewer -->
          <div
            class="relative w-[500px] aspect-[4/4.3] bg-[#EAE5DE] border border-[#DDD6CC] rounded-[3px] overflow-hidden group shadow-sm">
            <!-- Top Right Overlay Controls -->
            <div class="absolute top-4 right-4 z-20 flex items-center space-x-2">
              <button
                class="w-8 h-8 rounded-full bg-white/90 hover:bg-white text-[#332D28] flex items-center justify-center backdrop-blur shadow-sm transition-transform active:scale-95"
                title="Add to Wishlist">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
                    stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
              <button
                id="zoomProductImage"
                class="w-8 h-8 rounded-full bg-white/90 hover:bg-white text-[#332D28] flex items-center justify-center backdrop-blur shadow-sm transition-transform active:scale-95"
                title="Zoom In">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6"
                    stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
            </div>

            <!-- Folio Plate Art Canvas -->
            <div
              class="w-full h-full relative overflow-hidden bg-[#EAE5DE] flex items-center justify-center p-6 md:p-8">
              <img id="mainProductImage" src="<%= product.productImage[0] %>" alt="<%= product.productName %>"
                class="w-full h-full object-contain">
            </div>
          </div>

          <!-- Featured Plates Strip Header -->
          <div
            class="flex items-center justify-between text-[11px] pt-1 text-[#786E64] font-medium tracking-wider uppercase">
            <span class="text-[10px] text-[#9A9085]">SELECT VIEW TO INSPECT</span>
          </div>

          <!-- Thumbnail Plates Grid -->
          <div class="grid grid-cols-5 gap-2.5">
            <!-- Thumb 1 (Active) -->
            <% product.productImage.forEach((image,index)=>{ %>
              <button type="button" data-image="<%= image %>"
                class="aspect-[4/3] <%= index === 0 ? 'border-2 border-[#1E1A17]' : 'border border-[#DDD6CC] hover:border-[#1E1A17]' %> rounded-[2px] overflow-hidden bg-[#ECE8E1] p-1 flex items-center justify-center">
                <img src="<%= image %>" alt="<%= product.productName %> - image <%= index + 1 %>"
                  class="w-full h-full object-contain">
              </button>
              <%})%>
          </div>
        </section>

        <!-- Product Image Zoom Modal -->
        <div
            id="productZoomModal"
            class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">

            <!-- Close Button -->
            <button

          </div>
          <!-- Archival Custody & Delivery Assurances -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 mt-8 pt-6 border-t border-[#E5DDD2]">
            <!-- Assurance 1 -->
            <div class="bg-[#F5EFE7] p-3.5 rounded-[2px] border border-[#E6DDD0] flex flex-col justify-start">

            </div>
          </div>
        </section>
      </div>
      <!-- BEGIN: ProductEditorialTabsSection -->
      <section class="mt-14 pt-8" data-purpose="product-tabs">
        <div class="bg-[#F8F4EE] border border-[#E5DED4] p-8 lg:p-10 rounded-[3px]">
          <!-- Navigation Tab Headers -->
          <div class="flex items-center space-x-8 border-b border-[#DFD7CC] pb-4 mb-8">
            <button
              class="font-serif-book text-lg font-semibold text-[#1C1815] relative pb-4 -mb-4 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-[#1C1815]">

<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Verify Your Email Address — The Untold Stories</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Google Fonts: Cormorant Garamond & Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600&amp;display=swap"
        rel="stylesheet" />
    <!-- Tailwind Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
                        sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
                    },
                    colors: {
                        parchment: {
                            50: '#fcfbf9',
                            100: '#faf7f2',
                            200: '#f5efe6',
                            300: '#eee5d5',
                            400: '#e1d5be',
                            800: '#433d37',
                            900: '#2b2723',
                        },
                        charcoal: {
                            800: '#262423',
                            900: '#1a1918',
                        },
                        terracotta: {
                            600: '#b85d34',
                            700: '#a34822',
                        },
                        bronze: {
                            DEFAULT: '#9e623f',
                            dark: '#7e4726'
                        }
                    }
                }
            }
        }
    </script>
    <!-- Custom Styles: Background, Watermarks & Typography -->
    <style data-purpose="custom-decorations">
        body {
            background-color: #faf6f0;
            color: #2b2723;
        }

        /* Subtle dot grid pattern seen in the reference series */
        .bg-dot-pattern {
            background-image: radial-gradient(rgba(180, 160, 140, 0.22) 1px, transparent 1px);
            background-size: 24px 24px;
        }

        /* Soft ambient vignette glow */
        .archival-glow {
            background: radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.85) 0%, rgba(248, 243, 235, 0.45) 60%, rgba(243, 236, 226, 0.8) 100%);
        }

        /* Number input styling without arrows */
        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input[type=number] {
            -moz-appearance: textfield;
        }
    </style>
</head>

<%- include('../partials/user/header')%>
<body
    class="min-h-screen flex flex-col font-sans bg-[#faf6f0] antialiased selection:bg-amber-100 selection:text-amber-900">

    <!-- BEGIN: VerificationContentSection -->
    <main class="flex-grow flex items-center justify-center py-16 px-4 sm:px-6 relative bg-dot-pattern archival-glow">
        <!-- Central Verification Card -->
        <section
            class="relative w-full max-w-[580px] bg-white rounded-2xl shadow-[0_20px_50px_rgba(40,30,20,0.06)] border border-[#ece4d8] p-8 sm:p-12 overflow-hidden"
            data-purpose="verification-modal">
            <!-- Top-right delicate archival watermark engraving (T&S) -->
            <div class="absolute -top-10 -right-10 w-52 h-52 pointer-events-none opacity-40 select-none">
                <svg class="w-full h-full text-[#c5b8a5] stroke-current" fill="none" viewbox="0 0 200 200">
                    <!-- Outer circular compass dial -->
                    <circle cx="100" cy="100" r="90" stroke-dasharray="3 3" stroke-width="0.75"></circle>
                    <circle cx="100" cy="100" r="76" stroke-width="0.5"></circle>
                    <line stroke-width="0.5" x1="100" x2="100" y1="10" y2="190"></line>
                    <line stroke-width="0.5" x1="10" x2="190" y1="100" y2="100"></line>
                    <line stroke-dasharray="2 2" stroke-width="0.5" x1="36.36" x2="163.64" y1="36.36" y2="163.64">
                    </line>
                    <line stroke-dasharray="2 2" stroke-width="0.5" x1="36.36" x2="163.64" y1="163.64" y2="36.36">
                    </line>
                    <!-- Central insignia watermark -->
                    <text fill="#a4937e" font-family="'Cormorant Garamond', Georgia, serif" font-size="28"
                        font-style="italic" stroke="none" text-anchor="middle" x="100" y="105">T&amp;S</text>
                </svg>
            </div>
            <!-- Icon Seal / Header Badge -->
            <div class="flex justify-center mb-7 relative z-10">
                <div
                    class="w-16 h-16 rounded-2xl bg-[#f8f5f0] border border-[#e8ded0] flex items-center justify-center shadow-inner">
                    <!-- Fine archival wax-seal / dot emblem -->
                    <span class="w-2.5 h-2.5 rounded-full bg-[#8c5a3a]/70"></span>
                </div>
            </div>
            <!-- Main Headline & Subtitle -->
            <div class="text-center relative z-10 mb-8">
                <h1
                    class="font-serif text-[38px] sm:text-[42px] leading-tight text-[#1c1b1a] font-normal mb-3 tracking-tight">
                    Verify Your Email Address
                </h1>
                <p class="text-[14px] sm:text-[15px] leading-relaxed text-[#6d6357] max-w-md mx-auto">
                    A 6–digit archival passkey was dispatched to your correspondence address:
                    <span class="block mt-1 font-medium text-[#2d2823]"><%= email %></span>
                </p>
            </div>
            <!-- Verification Form Form -->
            <form id="otpForm" action="/verify-otp" class="relative z-10 space-y-6" method="POST">
                <!-- Field label -->
                <div>
                    <label
                        class="block text-center text-[10px] uppercase font-bold tracking-[0.2em] text-[#8e8170] mb-4">
                        Six-Digit Archive Passkey
                    </label>
                    <!-- Six OTP input boxes -->
                    <div class="grid grid-cols-6 gap-2.5 sm:gap-3.5 max-w-md mx-auto"
                        data-purpose="otp-boxes-container">
                        <!-- Box 1 -->
                        <input aria-label="Digit 1"
                            class="w-full aspect-square text-center font-serif text-3xl font-medium text-[#1c1b1a] bg-[#f8f5f0] border border-[#e6dcce] rounded-xl focus:bg-white focus:border-[#1c1b1a] focus:ring-1 focus:ring-[#1c1b1a] outline-none transition-all shadow-inner"
                            maxlength="1" type="text" name="otp1"  />
                        <!-- Box 2 -->
                        <input aria-label="Digit 2"
                            class="w-full aspect-square text-center font-serif text-3xl font-medium text-[#1c1b1a] bg-[#f8f5f0] border border-[#e6dcce] rounded-xl focus:bg-white focus:border-[#1c1b1a] focus:ring-1 focus:ring-[#1c1b1a] outline-none transition-all shadow-inner"
                            maxlength="1" type="text" name="otp2" />
                        <!-- Box 3 -->
                        <input aria-label="Digit 3"
                            class="w-full aspect-square text-center font-serif text-3xl font-medium text-[#1c1b1a] bg-[#f8f5f0] border border-[#e6dcce] rounded-xl focus:bg-white focus:border-[#1c1b1a] focus:ring-1 focus:ring-[#1c1b1a] outline-none transition-all shadow-inner"
                            maxlength="1" type="text" name="otp3" />
                        <!-- Box 4 (Placeholder dot state) -->
                        <input aria-label="Digit 4"
                            class="w-full aspect-square text-center font-serif text-3xl font-medium text-[#8f8373] bg-[#f8f5f0] border border-[#e6dcce] rounded-xl focus:bg-white focus:border-[#1c1b1a] focus:ring-1 focus:ring-[#1c1b1a] outline-none transition-all shadow-inner"
                            maxlength="1" type="text" name="otp4" />
                        <!-- Box 5 (Placeholder dot state) -->
                        <input aria-label="Digit 5"
                            class="w-full aspect-square text-center font-serif text-3xl font-medium text-[#8f8373] bg-[#f8f5f0] border border-[#e6dcce] rounded-xl focus:bg-white focus:border-[#1c1b1a] focus:ring-1 focus:ring-[#1c1b1a] outline-none transition-all shadow-inner"
                            maxlength="1" type="text" name="otp5" />
                        <!-- Box 6 (Placeholder dot state) -->
                        <input aria-label="Digit 6"
                            class="w-full aspect-square text-center font-serif text-3xl font-medium text-[#8f8373] bg-[#f8f5f0] border border-[#e6dcce] rounded-xl focus:bg-white focus:border-[#1c1b1a] focus:ring-1 focus:ring-[#1c1b1a] outline-none transition-all shadow-inner"
                            maxlength="1" type="text" name="otp6" />
                    </div>
                </div>
                <!-- Passkey Validity / Timer Status Card -->
                <div
                    class="bg-[#f7f2ea] border border-[#e6dcce] rounded-xl p-4 flex items-center justify-between shadow-sm">
                    <div class="flex items-center space-x-3.5">
                        <!-- Archival wax stamp / hourglass icon badge -->
                        <div
                            class="w-10 h-10 rounded-lg bg-[#eee3d1] flex items-center justify-center shrink-0 text-[#9e5f38]">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-linecap="round"
                                stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24">
                                <path d="M5 22h14"></path>
                                <path d="M5 2h14"></path>
                                <path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22">
                                </path>
                                <path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"></path>
                            </svg>
                        </div>
                        <!-- Passkey validity message -->
                        <div>
                            <span class="block text-[10px] font-bold uppercase tracking-[0.16em] text-[#827464]">Passkey
                                Validity</span>
                            <p class="text-xs text-[#524940] mt-0.5">
                                OTP expires in <span id="otpTimer"
                                    class="font-serif italic font-semibold text-[#b83d28] text-xl">00:00</span>
                            </p>
                        </div>
                    </div>
                    <!-- Divider & Resend Link -->
                    <div class="flex items-center pl-4 border-l border-[#decbb4]">
                        <button
                            class="text-sm font-semibold text-stone-400 opacity-60 cursor-not-allowed transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                            type="button" id="resendOtp" disabled>
                            Resend Code
                        </button>
                    </div>
                </div>
                <!-- Primary CTA Button -->
                <button
                    class="w-full bg-[#1c1b1a] hover:bg-[#2e2a27] text-white py-3.5 px-6 rounded-lg font-semibold text-xs uppercase tracking-[0.18em] flex items-center justify-center gap-2.5 transition-all duration-200 shadow hover:shadow-md active:translate-y-px"
                    type="submit">
                    <!-- Archival key icon -->
                    <svg class="w-4 h-4 text-[#e2d5c3]" fill="none" stroke="currentColor" stroke-linecap="round"
                        stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24">
                        <circle cx="7.5" cy="15.5" r="5.5"></circle>
                        <path d="m21 2-9.6 9.6"></path>
                        <path d="m15.5 7.5 3 3"></path>
                        <path d="m18.5 4.5 3 3"></path>
                    </svg>
                    <span>Verify</span>
                </button>
            </form>
            <!-- Subtext / Return Link -->
            <div class="text-center mt-7 pt-4 border-t border-[#f4ede3]">
                <a class="inline-flex items-center gap-1.5 text-xs text-[#7d7162] hover:text-[#1c1b1a] transition-colors"
                    href="#">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-linecap="round"
                        stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24">
                        <line x1="19" x2="5" y1="12" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Return to enrollment or change email</span>
                </a>
            </div>
        </section>
    </main>
    <!-- END: VerificationContentSection -->
    <%- include('../partials/user/footer')%>
    <!-- Interactive script to handle OTP input focusing -->
     <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script data-purpose="otp-input-autofocus">
        document.addEventListener('DOMContentLoaded', () => {
            const inputs = document.querySelectorAll('[data-purpose="otp-boxes-container"] input');

            inputs.forEach((input, index) => {
                // Clear dot placeholder on focus
                input.addEventListener('focus', () => {
                    if (input.value === '·') {
                        input.value = '';
                    }
                    input.select();
                });

                // Restore dot placeholder if left empty
                input.addEventListener('blur', () => {
                    if (!input.value.trim()) {
                        input.value = '·';
                    }
                });

                // Auto move to next input on keyup
                input.addEventListener('keyup', (e) => {
                    if (e.key >= '0' && e.key <= '9') {
                        input.value = e.key;
                        if (index < inputs.length - 1) {
                            inputs[index + 1].focus();
                        }
                    } else if (e.key === 'Backspace') {
                        if (!input.value || input.value === '·') {
                            if (index > 0) {
                                inputs[index - 1].focus();
                            }
                        } else {
                            input.value = '·';
                        }
                    }
                });
            });




            const otpForm = document.getElementById('otpForm')
            otpForm.addEventListener('submit',async(event)=>{
                event.preventDefault()

                const otpInputs = document.querySelectorAll('[data-purpose="otp-boxes-container"] input')

                let enteredOtp = ''
                otpInputs.forEach((input)=>{
                    if(input.value !== '.'){
                        enteredOtp += input.value
                    }
                })
                if(!/^\d{6}$/.test(enteredOtp)){
                    event.preventDefault()
                    await Swal.fire({
                        icon:'warning',
                        title:'OTP required',
                        text: 'Please enter all six digits of the OTP.'
                    })
                    return
                }

                try {
                    const response = await fetch('/verify-otp',{
                        method: 'POST',
                        headers: {
                            'Content-Type':'application/json'
                        },
                        body: JSON.stringify({
                            otp1: otpInputs[0].value,
                            otp2: otpInputs[1].value,
                            otp3: otpInputs[2].value,
                            otp4: otpInputs[3].value,
                            otp5: otpInputs[4].value,
                            otp6: otpInputs[5].value
                        })
                    })

                    const result = await response.json()

                    if(!response.ok){
                        await Swal.fire({
                            icon: result.icon || 'error',
                            title: 'Verification failed',
                            text: result.message || 'Please try again'
                        })

                        if(result.redirectToSignup){
                            window.location.href = '/signup'
                        }
                        return
                    }
                    await Swal.fire({
                        icon: result.icon,
                        text: result.message,
                        showConfirmButton: false,
                        timer: 2000,
                        customClass: {
                            popup: 'untold-swal-popup'
                        }
                    })

                    if(result.redirectToHome){
                        window.location.href = '/'
                    }

                } catch (error) {
                    console.error('OTP verification error:', error);

                    await Swal.fire({
                        icon: 'error',
                        title: 'Something went wrong',
                        text: 'Please try again'
                    })
                }
            })




            const otpTimer = document.getElementById('otpTimer')
            const resendOtp = document.getElementById('resendOtp')
            let otpExpiresAt = <%= otpExpiresAt%>;
            let countdown
            function startCountdown(){
                clearInterval(countdown)

                function updateTimer(){
                    const timeLeft = Math.max(0,Math.ceil((otpExpiresAt - Date.now())/1000))
                    const minutes = Math.floor(timeLeft/60)
                    const seconds = timeLeft%60
                    otpTimer.textContent = `${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}`

                    if(timeLeft <= 0){
                        clearInterval(countdown)
                        otpTimer.textContent = 'Expired'
                        resendOtp.disabled = false
                        resendOtp.classList.remove('opacity-50', 'cursor-not-allowed', 'text-stone-400');
                        resendOtp.classList.add('text-[#C25E34]');
                        return;
                    }
                    resendOtp.disabled = true
                    resendOtp.classList.add('opacity-50', 'cursor-not-allowed', 'text-stone-400');
                    resendOtp.classList.remove('text-[#C25E34]');
                } 
                updateTimer()
                countdown = setInterval(updateTimer,1000)
            }
            startCountdown()




            // Resending OTP
            resendOtp.addEventListener('click', async()=>{
                try {
                    resendOtp.disabled = true
                    const response = await fetch('/resend-otp',{
                        method: 'POST'
                    })

                    const result = await response.json()

                    if(!response.ok){
                        await Swal.fire({
                            icon: 'error',
                            title: 'Unable to resend OTP',
                            text: 'Please try again'
                        })
                        resendOtp.disabled = true
                        return
                    }

                    await Swal.fire({
                        icon: 'success',
                        title: 'OTP sent!',
                        text: 'A new OTP has been sent to your email.',
                        timer: 2000,
                        showConfirmButton: false
                    })

                    otpExpiresAt = Number(result.otpExpiresAt)
                    startCountdown()

                } catch (error) {
                    
                    console.error('Resend OTP error:', error);

                    await Swal.fire({
                        icon:'error',
                        title:'Something went wrong',
                        text:'Please try again'
                    })

                    resendOtp.disabled = false

                }
            })     

        });



    </script>


</body>
</html>
<!DOCTYPE html>

<html class="h-full" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>404 Folio De-accessioned | The Untold Stories</title>
  <!-- Tailwind CSS CDN with plugins -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <!-- Google Fonts: Cormorant Garamond & Newsreader for authentic literary archival look, plus Plus Jakarta Sans -->
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500;1,600&amp;family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400;1,500&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600&amp;display=swap"
    rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            parchment: {
              50: '#fcfaf6',
              100: '#f7f4ee',
              200: '#ede8df',
              300: '#ded7c8',
            },
            terracotta: {
              DEFAULT: '#a35d33',
              hover: '#8c4e2a',
              light: '#fbf5ef',
            },
            ink: {
              900: '#1c1917',
              700: '#44403c',
              500: '#78716c',
              400: '#a8a29e',
            }
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Newsreader', 'Georgia', 'serif'],
            body: ['"Newsreader"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
          }
        }
      }
    };
  </script>
  <!-- BEGIN: Custom Archival Styling -->
  <style data-purpose="stippled-grid-pattern">
    /* Subtle archival dot matrix / stippled pattern background */
    .bg-dot-pattern {
      background-color: #faf7f2;
      background-image: radial-gradient(rgba(180, 168, 150, 0.35) 0.8px, transparent 0.8px);
      background-size: 24px 24px;
    }
  </style>
  <style data-purpose="editorial-typography">
    /* High contrast luxury serif styling */
    .font-editorial-numeral {
      font-family: 'Cormorant Garamond', serif;
      font-feature-settings: "liga" 1, "dlig" 1;
    }

    .text-balance-custom {
      text-wrap: balance;
    }
  </style>
  <!-- END: Custom Archival Styling -->
</head>

<body
  class="min-h-full flex flex-col font-sans text-ink-900 bg-[#faf7f2] antialiased selection:bg-[#ede2d2] selection:text-ink-900">
  <!-- BEGIN: MainContent -->
  <main
    class="flex-1 flex flex-col justify-center items-center px-4 sm:px-6 lg:px-8 py-16 sm:py-24 relative bg-dot-pattern"
    data-purpose="404-hero-section">
    <div class="max-w-3xl w-full mx-auto text-center flex flex-col items-center">
      <!-- Archival Notice Pill Badge -->
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#f4ede4] border border-[#e5dcd0] text-[#9b5832] mb-8 shadow-sm"
        data-purpose="folio-chip">
        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewbox="0 0 24 24">
          <path d="M19 2H6c-1.2 0-2 .8-2 2v16c0 .6.4 1 1 1s1-.4 1-1V5c0-.6.4-1 1-1h13c.6 0 1-.4 1-1s-.4-1-1-1z"></path>
          <path d="M20 5H8c-1.1 0-2 .9-2 2v14c0 .6.4 1 1 1h13c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-1 14H8V7h11v12z"></path>
          <path d="M10 9h7v1.5h-7zm0 3h7v1.5h-7zm0 3h4v1.5h-4z"></path>
        </svg>
        <span class="text-[10px] sm:text-[11px] font-medium tracking-widest uppercase">
          Folio De-Accessioned · Notice Ref. 404
        </span>
      </div>
      <!-- Prominent 404 Numeral & Missing Entry Badge -->
      <div class="flex items-baseline justify-center gap-3 sm:gap-4 mb-4" data-purpose="error-code-container">
        <span
          class="font-editorial-numeral text-7xl sm:text-8xl md:text-9xl italic font-normal tracking-tight text-ink-900 leading-none">
          404
        </span>
        <span class="text-[11px] sm:text-xs font-semibold tracking-widest uppercase text-ink-500 font-sans">
          / Missing Entry
        </span>
      </div>
      <!-- Main Editorial Headline -->
      <h1
        class="font-serif text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.18] font-normal text-ink-900 max-w-2xl mt-4 mb-6 tracking-[-0.01em] text-balance-custom">
        This chapter remains unwritten,<br class="hidden sm:inline" /> or lost to the margins of time.
      </h1>
      <!-- Literary Archival Description -->
      <p
        class="font-body text-base sm:text-lg text-ink-700 max-w-xl leading-relaxed sm:leading-relaxed font-light mb-8">
        The manuscript or index you requested cannot be retrieved. It may have been retired to our climate-controlled
        private vaults, rebound under a reclassified bibliographic reference, or dissolved from contemporary print.
      </p>

      <!-- Action Button -->
      <div class="pt-1">
        <a class="inline-flex items-center gap-2.5 px-6 py-3 bg-[#eeeae1] hover:bg-[#e4ded3] text-ink-900 border border-[#ded8cb] text-xs font-medium tracking-[0.16em] uppercase rounded-none transition-all duration-200 shadow-sm hover:shadow"
          data-purpose="cta-home" href="/">
          <!-- Open Book / Archive Icon -->
          <svg class="w-4 h-4 text-ink-700" fill="none" stroke="currentColor" stroke-width="1.6" viewbox="0 0 24 24">
            <path
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          Return to Home Page
        </a>
      </div>
    </div>
  </main>
  <!-- END: MainContent -->
  <%- include('../partials/user/footer')%>
</body>

</html>
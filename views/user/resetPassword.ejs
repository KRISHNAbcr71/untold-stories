<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>The Untold Stories - Rare Editions &amp; Literary Archive</title>
  <!-- Tailwind CSS CDN with forms and container queries plugins -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <!-- Google Fonts: Cormorant Garamond (editorial serif) and Plus Jakarta Sans (clean UI sans) -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700&amp;display=swap"
    rel="stylesheet">
  <!-- Tailwind Configuration -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
          },
          colors: {
            archive: {
              bg: '#FAF8F5',
              surface: '#FFFFFF',
              card: '#F6F3EE',
              badge: '#F3EDE4',
              accent: '#A06D46',
              accentLight: '#B88258',
              accentDark: '#8C5632',
              text: '#1C1917',
              muted: '#78716C',
              subtle: '#A8A29E',
              border: '#E7E2DA',
              darkBtn: '#181615',
            }
          }
        }
      }
    }
  </script>
  <style data-purpose="base-styling">
    body {
      background-color: #FAF8F5;
      color: #1C1917;
      font-family: 'Plus Jakarta Sans', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .font-cormorant {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }
  </style>
</head>
<%- include('../partials/user/header')%>
<body class="min-h-screen flex flex-col bg-[#FAF8F5] text-[#1C1917] selection:bg-[#EAE4DC] selection:text-[#181615]">
  <!-- BEGIN: MainContent -->
  <main class="flex-grow py-14 lg:py-20 px-6 lg:px-12">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- BEGIN: LeftVaultEditorial -->
      <section aria-labelledby="renewal-heading" class="lg:col-span-6 flex flex-col justify-start">
        <!-- Curatorial Protocol Badge -->
        <div
          class="inline-flex items-center gap-2 self-start bg-[#F2EDE5] border border-[#E5DDD2] px-3 py-1.5 rounded-sm mb-6 text-[#9A643D]">
          <svg class="w-4 h-4 stroke-[1.8] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="text-[10px] uppercase font-bold tracking-[0.2em]">Curatorial Protocol § 06</span>
        </div>
        <!-- Main Editorial Title -->
        <h1
          class="font-cormorant text-4xl sm:text-5xl lg:text-[54px] font-normal tracking-tight text-[#181615] leading-[1.08] mb-5"
          id="renewal-heading">
          Restoration of Vault Custody &amp; Key Renewal.
        </h1>
        <!-- Explanatory Subtext -->
        <p class="text-[#55504B] text-[15px] sm:text-[16px] leading-relaxed mb-8 max-w-xl font-normal">
          Create a resilient archival passkey to safeguard your private collection, reserved manuscripts, and reading
          chamber folio records across our global chambers.
        </p>
        <!-- Archival Library Desk Photo -->
        <div class="w-full overflow-hidden rounded-md border border-[#E4DDD3] bg-[#EAE4DC] shadow-sm mb-8">
          <img
            alt="Atmospheric archival library reading room desk with antique leather-bound book, spectacles, ink bottle, and manuscripts"
            class="w-full h-auto object-cover max-h-[360px]"
            src="https://lh3.googleusercontent.com/aida/AEtjO1WM8tZF3YwbU3y-HTXrLsTaZ5yRi11ZnmygWLlHFh063cPwBEliaeDY9-PhnZE1-koR_ovtmafCqcSo7WoNdflgKqX-xLy6WNCihMlMLgzzr3uuwRDBnoUOehS_zJoynqnZlhzkVpDMJJ0gfEM0i48EyMPsqvph-6Po-Zgbeao6ZUEJAAj5D3aY4J6OOxsrBJxdheeMV3oakSlqZsJNkq91c4ARNs49iiDVSgFXdPoCbjmVDqWtkEn9rEuc">
        </div>
        <!-- Callout Quote Card -->
        <div class="relative pl-6 py-4 pr-5 bg-[#FAF6F0] border-l-2 border-[#A06D46] rounded-r-sm">
          <p class="font-cormorant italic text-lg sm:text-[19px] text-[#2C2723] leading-snug">
            “A key well-forged turns smoothly in the quietest of doors.”
          </p>
          <p class="text-[10px] uppercase tracking-[0.2em] font-semibold text-[#A06D46] mt-2">
            — Archivist’s Manual, Edinburgh Salon
          </p>
        </div>
      </section>
      <!-- END: LeftVaultEditorial -->
      <!-- BEGIN: RightPasskeyForm -->
      <section aria-labelledby="form-card-title" class="lg:col-span-6 flex justify-center lg:justify-end">
        <div
          class="w-full max-w-[540px] bg-white rounded-lg border border-[#EDE8E0] shadow-[0_4px_24px_rgba(0,0,0,0.04)] p-8 sm:p-10">
          <!-- Archival Header Section inside Card -->
          <div class="pb-5 border-b border-[#EFEBE4] mb-7">
            <span class="text-[11px] uppercase tracking-[0.22em] font-bold text-[#A06D46]">Archival Passkey
              Renewal</span>
          </div>
          <!-- Card Title & Prompt -->
          <div class="mb-8">
            <h2
              class="font-cormorant text-3xl sm:text-[34px] font-normal tracking-tight text-[#191716] leading-snug mb-2"
              id="form-card-title">
              Set Your New Password
            </h2>
            <p class="text-[13.5px] text-[#5C5651] leading-relaxed">
              Use at least 8 characters, including an uppercase letter, a lowercase letter, a number, and a special
              character. Spaces are not allowed.
            </p>
          </div>
          <!-- Passkey Form Inputs -->
          <form id="resetPasswordForm" action="/reset-password" class="space-y-6" method="POST" novalidate>
            <% if (typeof message !=='undefined' && message) { %>
              <p class="text-red-600 text-sm mb-4 text-center">
                <%= message %>
              </p>
              <% } %>
                <!-- Field 1: New Passkey -->
                <div>
                  <label
                    class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.18em] text-[#332E2A] mb-2.5"
                    for="new-passkey">
                    <!-- Key Icon -->
                    <svg class="w-4 h-4 text-[#A06D46] stroke-[2]" fill="none" stroke="currentColor"
                      viewBox="0 0 24 24">
                      <path
                        d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
                        stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    <span class="">New Passkey</span>
                  </label>
                  <div class="relative">
                    <input
                      class="w-full bg-[#F5F2EC]/80 border border-[#DDD6CB] rounded-md px-4 py-3.5 text-sm tracking-widest text-[#1C1917] focus:border-[#A06D46] focus:ring-1 focus:ring-[#A06D46] outline-none transition"
                      id="new-passkey" name="newPassword" placeholder="Enter new passkey" required="" type="password">
                    <button aria-label="Toggle password visibility"
                      class="absolute right-3.5 top-1/2 -translate-y-1/2 text-[#888179] hover:text-[#181615] transition-colors p-1"
                      type="button" id="togglePassword">
                      <!-- Eye Slashed / Visibility Icon -->
                      <svg class="w-5 h-5 stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path
                          d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"
                          stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </button>
                  </div>
                  <p id="newPasswordError" class="text-red-600 text-sm mt-1"></p>
                </div>
                <!-- Field 2: Confirm New Passkey -->
                <div>
                  <label
                    class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.18em] text-[#332E2A] mb-2.5"
                    for="confirm-passkey">
                    <!-- Lock Icon -->
                    <svg class="w-4 h-4 text-[#A06D46] stroke-[2]" fill="none" stroke="currentColor"
                      viewBox="0 0 24 24">
                      <path
                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                        stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    <span class="">Confirm New Passkey</span>
                  </label>
                  <div class="relative">
                    <input
                      class="w-full bg-[#F5F2EC]/80 border border-[#DDD6CB] rounded-md px-4 py-3.5 text-sm tracking-widest text-[#1C1917] focus:border-[#A06D46] focus:ring-1 focus:ring-[#A06D46] outline-none transition"
                      id="confirm-passkey" name="confirmPassword" placeholder="Repeat new passkey" required=""
                      type="password">
                    <button aria-label="Toggle password visibility"
                      class="absolute right-3.5 top-1/2 -translate-y-1/2 text-[#888179] hover:text-[#181615] transition-colors p-1"
                      type="button">
                      <!-- Eye Slashed / Visibility Icon -->
                      <svg class="w-5 h-5 stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path
                          d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"
                          stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </button>
                  </div>
                  <p id="confirmPasswordError" class="text-red-600 text-sm mt-1"></p>
                </div>
                <!-- Requirements Box -->
                <div class="bg-[#F6F3EE] border border-[#E9E3D9] rounded-md p-5 mt-6">
                  <span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-[#6E6760] mb-3.5">
                    Archival Custody Requirements
                  </span>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-3 gap-x-4">
                    <!-- Req 1 -->
                    <div class="flex items-center gap-2.5">
                      <span
                        class="flex items-center justify-center w-4 h-4 rounded-full border border-[#A06D46] text-[#A06D46] flex-shrink-0">
                        <svg class="w-2.5 h-2.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                      </span>
                      <span class="text-[12.5px] text-[#423D38]">At least 8 characters</span>
                    </div>
                    <!-- Req 2 -->
                    <div class="flex items-center gap-2.5">
                      <span
                        class="flex items-center justify-center w-4 h-4 rounded-full border border-[#A06D46] text-[#A06D46] flex-shrink-0">
                        <svg class="w-2.5 h-2.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                      </span>
                      <span class="text-[12.5px] text-[#423D38]">Uppercase &amp; lowercase</span>
                    </div>
                    <!-- Req 3 -->
                    <div class="flex items-center gap-2.5">
                      <span
                        class="flex items-center justify-center w-4 h-4 rounded-full border border-[#A06D46] text-[#A06D46] flex-shrink-0">
                        <svg class="w-2.5 h-2.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                      </span>
                      <span class="text-[12.5px] text-[#423D38]">Numeral included</span>
                    </div>
                    <!-- Req 4 -->
                    <div class="flex items-center gap-2.5">
                      <span
                        class="flex items-center justify-center w-4 h-4 rounded-full border border-[#A06D46] text-[#A06D46] flex-shrink-0">
                        <svg class="w-2.5 h-2.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                      </span>
                      <span class="text-[12.5px] text-[#423D38]">Special character</span>
                    </div>
                  </div>
                </div>
                <!-- Primary Action Submit Button -->
                <button
                  class="w-full mt-7 bg-[#1A1816] hover:bg-[#2D2926] text-white py-4 px-6 rounded-sm text-xs font-bold uppercase tracking-[0.2em] flex items-center justify-center gap-3 transition-colors shadow-sm"
                  type="submit">
                  <span class="">Update Password &amp; Enter Sanctuary</span>
                  <svg class="w-4 h-4 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </button>
          </form>
        </div>
      </section>
      <!-- END: RightPasskeyForm -->
    </div>
  </main>
  <!-- END: MainContent -->
  <%- include('../partials/user/footer')%>

</body>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  const resetPasswordForm = document.getElementById('resetPasswordForm')
  const newPasswordInput = document.getElementById('new-passkey')
  const confirmPasswordInput = document.getElementById('confirm-passkey')
  const newPasswordError = document.getElementById('newPasswordError')
  const confirmPasswordError = document.getElementById('confirmPasswordError')

  resetPasswordForm.addEventListener('submit', async (event) => {
    event.preventDefault()

    const passwordValue = newPasswordInput.value
    const confirmPasswordValue = confirmPasswordInput.value
    const passwordPattern = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9\s])\S{8,}$/

    if (passwordValue === '') {
      event.preventDefault()
      newPasswordError.textContent = 'Password is required'
    } else if (!passwordPattern.test(passwordValue)) {
      event.preventDefault()
      newPasswordError.textContent = 'Use at least 8 characters with uppercase, lowercase, a number and a special character. Spaces are not allowed'
    } else {
      newPasswordError.textContent = ''
    }

    if (confirmPasswordValue === '') {
      event.preventDefault()
      confirmPasswordError.textContent = 'Please confirm your password'
    } else if (confirmPasswordValue !== passwordValue) {
      event.preventDefault()
      confirmPasswordError.textContent = 'Password do not match'
    } else {
      confirmPasswordError.textContent = ''
    }





    if (passwordValue !== '' && passwordPattern.test(passwordValue) && confirmPasswordValue !== '' && confirmPasswordValue === passwordValue) {
      try {
        const response = await fetch('/reset-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded'
          },
          body: new URLSearchParams({
            newPassword: passwordValue,
            confirmPassword: confirmPasswordValue
          })
        })

        const result = await response.json()

        await Swal.fire({
          icon: result.icon,
          text: result.message,
          confirmButtonColor: '#A06D46'
        })

        if (response.ok && result.redirectUrl) {
          window.location.href = result.redirectUrl
        }

      } catch (error) {
        console.error('Reset password error:', error);

        Swal.fire({
          icon: 'error',
          text: 'Something went wrong. Please try again.',
          confirmButtonColor: '#A06D46'
        });

      }
    }

  })

  newPasswordInput.addEventListener('input', () => {
    newPasswordError.textContent = ''
    if (confirmPasswordInput !== '') {
      confirmPasswordError.textContent = ''
    }
  })


  const togglePassword = document.getElementById('togglePassword')
  togglePassword.addEventListener('click', () => {
    if (newPasswordInput.type === 'password') {
      newPasswordInput.type = 'text'
    } else {
      newPasswordInput.type = 'password'
    }
  })

  const toggleConfirmPassword = confirmPasswordInput.parentElement.querySelector('button')
  toggleConfirmPassword.addEventListener('click', () => {
    if (confirmPasswordInput.type === 'password') {
      confirmPasswordInput.type = 'text'
    } else {
      confirmPasswordInput.type = 'password'
    }
  })

</script>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>The Untold Stories - Rare Editions &amp; Literary Archive</title>
    <!-- Tailwind CSS v3 with forms and container queries -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Google Fonts: Cormorant Garamond & Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700&amp;display=swap"
        rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        parchment: '#f8f4ee',
                        'parchment-subtle': '#fbf8f4',
                        'archival-gold': '#b97343',
                        'archival-bronze': '#9a532d',
                        'chamber-dark': '#242426',
                        'field-bg': '#f2eeea',
                        'card-border': '#eae3d9'
                    },
                    fontFamily: {
                        serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style data-purpose="typography">
        body {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            background-color: #f8f4ee;
            color: #383431;
        }

        .font-editorial {
            font-family: 'Cormorant Garamond', Georgia, serif;
        }
    </style>
    <style data-purpose="custom-utilities">
        /* Subtle decorative elements & custom scroll smoothing */
        html {
            scroll-behavior: smooth;
        }

        input::placeholder {
            color: #7b756f;
            font-size: 0.925rem;
        }
    </style>
</head>
<%- include('../partials/user/header')%>

    <body class="min-h-screen flex flex-col bg-[#f8f4ee] text-[#2c2825] antialiased selection:bg-[#dfd3c3]">

        <!-- BEGIN: MainContent -->
        <main class="flex-grow">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
                <div
                    class="bg-white rounded-3xl shadow-xl border border-[#ece4d9] overflow-hidden grid grid-cols-1 lg:grid-cols-12">
                    <div
                        class="lg:col-span-5 bg-[#f8f4ee] border-b lg:border-b-0 lg:border-r border-[#ece4d9] p-8 lg:p-10 flex flex-col justify-between">
                        <div class="space-y-6">
                            <div>
                                <div
                                    class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-[#eee7dd] text-[#8e4f2b] text-[10px] font-bold tracking-[0.2em] uppercase mb-4">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.8"
                                        viewBox="0 0 24 24">
                                        <path
                                            d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                                            stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg><span class="">Sanctuary Register / Vault Access</span>
                                </div>
                                <h1
                                    class="font-editorial text-3xl sm:text-4xl lg:text-[2.65rem] font-medium leading-[1.18] text-[#1b1917] tracking-tight">
                                    The quiet chamber awaits your return.</h1>
                                <p class="text-[#564f48] text-sm leading-relaxed mt-3 font-light">Sign in to track rare
                                    acquisitions, manage your private study reservations, and continue reading your
                                    saved folios across our archival holdings.</p>
                            </div>
                            <div class="relative rounded-xl overflow-hidden shadow-sm aspect-[16/10] bg-[#3a2e26]"><img
                                    alt="Old wooden chamber library with arched window, books and ancient folio"
                                    class="w-full h-full object-cover brightness-[0.92] contrast-[1.03]"
                                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuCdaEwepFpRBFWSI6SJoF1P4ijd6mCbme9qvBeYKvJ0d5cDctBg96_b-1X9tOJWhX1lPViARDNUOh-uDatoUsYnGhDsLduqLVAAiEuuXBJS9BcXPDpklUplmKGJidykDB0CheLqaX2J7o72xX_DtIiYoN3Yc6kVcgkmI9RCz5qMkHMqQsgShRrVgUfyZaT0GGWXsz9aQqbCmJOega-0kKYB9ztPUoswDnHZU90mFJnSma6vfN9cSHiprw">
                            </div>
                        </div>
                        <div class="mt-8 pt-6 border-t border-[#ece4d9]">
                            <div class="flex items-start space-x-3">
                                <div
                                    class="w-8 h-8 rounded-lg bg-[#eee7dd] text-[#9a532d] flex items-center justify-center shrink-0 mt-0.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8"
                                        viewBox="0 0 24 24">
                                        <path
                                            d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                                            stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                </div>
                                <div><span
                                        class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#9a532d] block">Reading
                                        Room Note</span>
                                    <p class="font-editorial italic text-sm text-[#24211e] leading-snug mt-0.5">“Books
                                        are the quietest and most constant of friends; they are the most accessible and
                                        wisest of counselors.”</p><span
                                        class="text-[10px] tracking-wider uppercase text-[#7d756d] block mt-1">— Charles
                                        William Eliot</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="lg:col-span-7 bg-white p-8 sm:p-12 lg:p-14 flex flex-col justify-center">
                        <div class="max-w-md mx-auto w-full">
                            <div class="mb-8 text-center sm:text-left"><span
                                    class="text-[10px] uppercase font-bold tracking-[0.22em] text-[#8e4f2b] block mb-2">Member
                                    Access • Vault Login</span>
                                <h2
                                    class="font-editorial text-3xl sm:text-4xl text-[#1e1b18] font-normal tracking-tight">
                                    Log In to Your Reader Account</h2>
                                <p class="text-[#6c655d] text-xs font-light tracking-wide mt-2 leading-relaxed">Enter
                                    your bibliophile credentials to access your curatorial vaults and private
                                    reservations.</p>
                            </div>
                            <form id="loginForm" action="/login" class="space-y-4" method="POST" novalidate autocomplete="off">
                                <% if(typeof message !== 'undefined' && message) {%>
                                    <div id="error-message" class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-md px-4 py-3">
                                        <%= message%>
                                    </div>
                                    <%}%>
                                <!-- Email -->
                                <div>
                                    <label
                                        class="block text-xs font-medium text-[#554e47] tracking-wider uppercase mb-1.5"
                                        for="username">Email Address</label>
                                    <div class="relative flex items-center">
                                        <div class="w-full">
                                            <div class="relative w-full">
                                                <div
                                                    class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#7d756d]">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8"
                                                        viewBox="0 0 24 24">
                                                        <path
                                                            d="M16.5 12a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zm0 0c0 1.657 1.007 3 2.25 3S21 13.657 21 12a9 9 0 10-2.636 6.364M16.5 12V8.25"
                                                            stroke-linecap="round" stroke-linejoin="round">
                                                        </path>
                                                    </svg>
                                                </div>
                                                <input
                                                    class="w-full bg-[#f8f4ee] border border-[#e5dcd0] text-[#25221f] text-xs rounded-xl pl-10 pr-3.5 py-3 focus:ring-1 focus:ring-[#9a532d] focus:bg-white placeholder:text-[#888179] transition"
                                                    id="email" name="email" placeholder="eleanor.vance@archival.org" autocomplete="off"
                                                    type="email">
                                            </div>
                                            <p id="emailError" class="text-red-600 text-sm mt-1"></p>   
                                        </div>
                                    </div>
                                </div>
                                <!-- Password -->
                                <div>
                                    <div class="flex items-center justify-between mb-1.5">
                                        <label
                                            class="block text-xs font-medium text-[#554e47] tracking-wider uppercase"
                                            for="password">Password
                                        </label>
                                            <a
                                                class="text-xs text-[#a35e38] hover:text-[#7f4423] font-medium transition-colors"
                                                href="/forgot-password">Forgot password?
                                            </a>
                                    </div>
                                    <div class="relative flex items-center">
                                        <div class="w-full">
                                            <div class="relative w-full">
                                                <div
                                                    class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#7d756d]">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8"
                                                        viewBox="0 0 24 24">
                                                            <path
                                                                d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
                                                                stroke-linecap="round" stroke-linejoin="round">
                                                            </path>
                                                    </svg>
                                                </div>
                                                <input
                                                    class="w-full bg-[#f8f4ee] border border-[#e5dcd0] text-[#25221f] text-xs rounded-xl pl-10 pr-10 py-3 focus:ring-1 focus:ring-[#9a532d] focus:bg-white placeholder:text-[#888179] transition"
                                                    id="password" name="password" placeholder="••••••••" autocomplete="new-password"
                                                    type="password">

                                                <button aria-label="Toggle password visibility"
                                                    class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-[#7d756d] hover:text-[#25221f]"
                                                    type="button" id="togglePassword">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                        stroke-width="1.8" viewBox="0 0 24 24">
                                                        <path
                                                            d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"
                                                            stroke-linecap="round" stroke-linejoin="round"></path>
                                                        <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round"
                                                            stroke-linejoin="round"></path>
                                                    </svg>
                                                </button>
                                            </div>
                                            <p id="passwordError" class="text-red-600 text-sm mt-1"></p>
                                        </div>
                                    </div>
                                </div>

                                <div class="pt-2"><button
                                        class="w-full bg-[#242426] hover:bg-[#39383b] text-white py-3.5 px-4 rounded-xl font-semibold text-xs tracking-wider uppercase flex items-center justify-center space-x-2 transition-all shadow-sm"
                                        type="submit"><span class="">Log In</span><svg class="w-4 h-4 text-white"
                                            fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" stroke-linecap="round"
                                                stroke-linejoin="round"></path>
                                        </svg></button></div>
                                <div class="relative flex items-center justify-center py-2">
                                    <div class="border-t border-[#e7e1d8] w-full"></div><span
                                        class="bg-white px-3 text-[10px] tracking-widest text-[#948c82] uppercase">or</span>
                                    <div class="border-t border-[#e7e1d8] w-full"></div>
                                </div>

                                <div>
                                    <a href="/auth/google"
                                        class="w-full bg-[#f8f4ee] hover:bg-[#eae3d9] text-[#34302c] py-3 px-4 rounded-xl font-semibold text-xs tracking-wider uppercase flex items-center justify-center space-x-3 transition-colors border border-[#e5dcd0]"
                                        ><svg class="w-4 h-4" viewBox="0 0 24 24">
                                            <path
                                                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                                                fill="#4285F4"></path>
                                            <path
                                                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                                                fill="#34A853"></path>
                                            <path
                                                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
                                                fill="#FBBC05"></path>
                                            <path
                                                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
                                                fill="#EA4335"></path>
                                        </svg><span class="text-xs font-semibold text-[#38332f] tracking-wider">Sign in
                                            with Google</span>
                                        </a>
                                </div>
                                <div class="text-center pt-3">
                                    <p class="text-xs text-[#6e6862]">Don't have an account? <a
                                            class="text-[#a85c35] hover:text-[#7f4423] font-semibold underline underline-offset-2 ml-1"
                                            href="#">Register</a></p>
                                </div>
                                <div class="pt-4 border-t border-[#eee7dc] text-center">
                                    <p class="text-[11px] text-[#948c82] leading-relaxed">By logging in, you reaffirm
                                        your adherence to our <a class="underline hover:text-[#25221f]"
                                            href="#">Archival Charter</a> and <a class="underline hover:text-[#25221f]"
                                            href="#">Provenance Guarantee</a>.</p>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <!-- END: MainContent -->
        <%- include('../partials/user/footer')%>


    </body>

    <script>
        const login = document.getElementById('loginForm')
        const emailInput = document.getElementById('email')
        const emailError = document.getElementById('emailError')
        const passwordInput = document.getElementById('password')
        const passwordError = document.getElementById('passwordError')

        login.addEventListener('submit',(event)=>{
            const email = emailInput.value.trim()
            const password = passwordInput.value.trim()
            const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

            if(email === ''){
                event.preventDefault()
                emailError.textContent = 'Email is required'
            }else if(!emailPattern.test(email)){
                event.preventDefault()
                emailError.textContent = 'Please enter a valid email address'
            }else {
                emailError.textContent = ''
            }

            if(password === ''){
                event.preventDefault()
                passwordError.textContent = 'Password is required'
            }else {
                passwordError.textContent = ''
            }

        })

        emailInput.addEventListener('input',()=>{
            emailError.textContent = ''
        })

        passwordInput.addEventListener('input',()=>{
            passwordError.textContent = ''
        })



        // Password visibility button
        const togglePassword = document.getElementById('togglePassword')
        togglePassword.addEventListener('click',()=>{
            if(passwordInput.type === 'password'){
                passwordInput.type = 'text'
            }else{
                passwordInput.type = 'password'
            }
        })


        const errorMessage = document.getElementById('error-message')
        emailInput.addEventListener('input',()=>{
            if(errorMessage){
                errorMessage.remove()
            }
        })

        passwordInput.addEventListener('input',()=>{
            if(errorMessage){
                errorMessage.remove()
            }
        })

    </script>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>The Untold Stories — Rare Editions &amp; Literary Archive</title>
  <!-- Google Fonts: Cormorant Garamond & Inter -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700&amp;display=swap"
    rel="stylesheet">
  <!-- Tailwind CSS CDN with plugins -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            parchment: {
              50: '#FDFBF7',
              100: '#F8F5EE',
              200: '#EFE9DE',
              300: '#E2DACB',
              400: '#CFC3AE',
            },
            archive: {
              900: '#1C1A17',
              800: '#2A2622',
              700: '#3D3833',
              600: '#5A534C',
              500: '#7E766D',
              400: '#A49B8F',
              300: '#C8C1B5',
              200: '#E4DFD5',
              100: '#F2EFEB',
              amber: '#9E5B32',
              tan: '#8C5E3C'
            }
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style data-purpose="custom-decorations">
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #D1C7B7;
      border-radius: 4px;
    }

    /* Book spine depth simulation */
    .book-shadow {
      box-shadow: -8px 0 15px -4px rgba(0, 0, 0, 0.25), 0 10px 25px -5px rgba(0, 0, 0, 0.18);
    }

    .book-spine-left {
      background: linear-gradient(90deg, rgba(0, 0, 0, 0.28) 0%, rgba(255, 255, 255, 0.08) 3%, rgba(0, 0, 0, 0.18) 7%, rgba(0, 0, 0, 0.02) 15%, transparent 100%);
    }
  </style>
</head>

<body
  class="bg-[#F9F7F2] text-archive-800 font-sans antialiased selection:bg-[#E2DACB] selection:text-archive-900 min-h-screen flex flex-col justify-between">
  <%- include('../partials/user/header')%>

    <main class="max-w-7xl mx-auto px-4 sm:px-8 py-8 w-full">
      <!-- BEGIN: SearchAndSortBar -->
      <section class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center mb-8 pb-4">

        <!-- Live Search Query Box -->
        <form id="shopSearchForm" action="/shop" method="GET" class="md:col-span-5 relative">

          <input type="hidden" name="category" value="<%= selectedCategory || '' %>">

          <input type="hidden" name="author" value="<%= selectedAuthor || '' %>">

          <input type="hidden" name="priceRange" value="<%= selectedPriceRange || '' %>">

          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-archive-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"
                stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <input
            aria-label="Filter current catalog"
            name="search"
            value="<%= search || '' %>"
            placeholder="Search books..."
            class="w-full pl-10 pr-9 py-2.5 bg-[#FAF7F2] border border-[#DDD5C5] rounded text-sm text-archive-900 font-medium focus:border-archive-amber focus:ring-1 focus:ring-archive-amber outline-none transition"
            type="text"
          >

          <button
            type="button"
            onclick="window.location.href='/shop?sort=<%= encodeURIComponent(sort || '') %>&category=<%= encodeURIComponent(selectedCategory || '') %>&author=<%= encodeURIComponent(selectedAuthor || '') %>&priceRange=<%= encodeURIComponent(selectedPriceRange || '') %>'"
            class="absolute inset-y-0 right-0 pr-3 flex items-center text-archive-400 hover:text-archive-700"
            title="Clear Search">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M6 18L18 6M6 6l12 12"
                stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>

        </form>


        <!-- Result Count Banner -->
        <div
          class="md:col-span-4 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-archive-600 bg-[#F4EFE6]/60 border border-[#E5DECF] py-2 px-3.5 rounded">
          <svg class="w-4 h-4 text-archive-amber" fill="none" stroke="currentColor" stroke-width="1.8"
            viewBox="0 0 24 24">
            <path
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="">SHOWING <%= products.length %> OF <%= totalProducts %> CURATED TITLES</span>
        </div>
        <!-- Sorting Select -->
        <div class="md:col-span-3 flex justify-end">
          <div class="relative w-full">
            <select
              name="sort"
              onchange="this.form.submit()"
              form="shopSearchForm"
              class="w-full text-xs font-medium bg-[#FAF7F2] text-archive-800 border border-[#DDD5C5] rounded py-2.5 pl-3.5 pr-8 appearance-none focus:outline-none focus:border-archive-amber focus:ring-1 focus:ring-archive-amber cursor-pointer">

              <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>
                New Arrivals
              </option>

              <option value="price-low" <%= sort === 'price-low' ? 'selected' : '' %>>
                Price: Low to High
              </option>

              <option value="price-high" <%= sort === 'price-high' ? 'selected' : '' %>>
                Price: High to Low
              </option>

              <option value="name-asc" <%= sort === 'name-asc' ? 'selected' : '' %>>
                A–Z
              </option>

              <option value="name-desc" <%= sort === 'name-desc' ? 'selected' : '' %>>
                Z–A
              </option>
            </select>

            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-archive-500">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
          </div>
        </div>
      </section>
      <!-- END: SearchAndSortBar -->
      <!-- BEGIN: TwoColumnCatalogLayout -->
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-stretch">
        <!-- BEGIN: CuratorialFilterSidebar -->
        <form action='/shop' method='GET'>
          <input type="hidden" name="sort" value="<%= sort || '' %>">

          <input type="hidden" name="search" value="<%= search || '' %>">
          <aside
            class="lg:col-span-1 bg-[#FDFBF7] border border-[#E3DC CE] rounded-lg p-5 space-y-6 shadow-sm self-start flex flex-col">
            <!-- Sidebar Top -->
            <div class="flex items-center justify-between border-b border-[#EFE9DD] pb-3.5">
              <div class="flex items-center space-x-2">
                <svg class="w-4 h-4 text-archive-amber" fill="none" stroke="currentColor" stroke-width="2"
                  viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path
                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                  </path>
                </svg>
                <h2 class="font-serif font-bold text-lg text-archive-900 leading-tight">Curatorial Filters</h2>
              </div>
              <button
                class="text-[10px] tracking-wider font-semibold text-archive-500 hover:text-archive-amber uppercase transition-colors"
                type="button"
                onclick="window.location.href='/shop'">CLEAR
                ALL</button>
            </div>
            <!-- Selected Tags -->

            <!-- Filter Section 1: Literary Category -->
            <div class="space-y-3">
              <div
                class="flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-archive-600">
                <span class="">Literary Category</span>
              </div>
              <div class="space-y-2 text-xs text-archive-700">
                <% categories.forEach(category=>{ %>
                <label class="flex items-center justify-between cursor-pointer group">
                  <span class="flex items-center space-x-2">
                    <input 
                      class="w-3.5 h-3.5 text-archive-900 border-[#C5BBA9] focus:ring-0 focus:ring-offset-0"
                      type="radio"
                      name="category"
                      value="<%= category._id %>"
                      <%= selectedCategory === category._id.toString() ? 'checked' : '' %>>
                    <span class="font-medium text-archive-900"><%= category.name %></span>
                  </span>
                </label>
                <%})%>
              </div>
            </div>

            <!-- Filter Section 2: Price Range (INR) -->
            <div class="space-y-3 pt-3 border-t border-[#EFE9DD]">
                <div
                    class="flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-archive-600">
                    <span>Price Range</span>
                </div>
                <div class="space-y-2 text-xs text-archive-700">
                    <label class="flex items-center justify-between cursor-pointer group">
                        <span class="flex items-center space-x-2">
                            <input
                                type="radio"
                                name="priceRange"
                                value="100-500"
                                <%= selectedPriceRange === '100-500' ? 'checked' : '' %>
                                class="w-3.5 h-3.5 text-archive-900 border-[#C5BBA9] focus:ring-0 focus:ring-offset-0">
                            <span class="font-medium text-archive-900">₹100 – ₹500</span>
                        </span>
                    </label>
                    <label class="flex items-center justify-between cursor-pointer group">
                        <span class="flex items-center space-x-2">
                            <input
                                type="radio"
                                name="priceRange"
                                value="500-1000"
                                <%= selectedPriceRange === '500-1000' ? 'checked' : '' %>
                                class="w-3.5 h-3.5 text-archive-900 border-[#C5BBA9] focus:ring-0 focus:ring-offset-0">
                            <span>₹500 – ₹1,000</span>
                        </span>
                    </label>
                    <label class="flex items-center justify-between cursor-pointer group">
                        <span class="flex items-center space-x-2">
                            <input
                                type="radio"
                                name="priceRange"
                                value="1000-plus"
                                <%= selectedPriceRange === '1000-plus' ? 'checked' : '' %>
                                class="w-3.5 h-3.5 text-archive-900 border-[#C5BBA9] focus:ring-0 focus:ring-offset-0">
                            <span>Above ₹1,000</span>
                        </span>
                    </label>
                </div>
            </div>
            <!-- Filter Section 3: Authors & Curators -->
            <div class="space-y-3 pt-3 border-t border-[#EFE9DD]">
              <div
                class="flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-archive-600">
                <span class="">Authors &amp; Curators</span>
              </div>
              <div class="space-y-2 text-xs text-archive-700">
                <%authors.forEach(author=>{%>
                <label class="flex items-center justify-between cursor-pointer group">
                  <span class="flex items-center space-x-2">
                    <input 
                      class="w-3.5 h-3.5 text-archive-900 border-[#C5BBA9] focus:ring-0 focus:ring-offset-0"
                      type="radio"
                      name="author"
                      value="<%= author %>"
                      <%= selectedAuthor === author ? 'checked' : '' %>>
                    <span class="font-medium text-archive-900"><%= author %></span>
                  </span>
                </label>
                <%})%>
              </div>
            </div>
            <!-- Sidebar Buttons -->
            <div class="space-y-2 pt-2 border-t border-[#EFE9DD]">
              <button
                type="submit"
                class="w-full bg-[#1C1A17] hover:bg-black text-[#F4EFE6] font-medium text-xs py-2.5 rounded tracking-wider uppercase transition shadow-sm">
                APPLY FILTERS
              </button>
            </div>
          </aside>
        </form>
        <!-- END: CuratorialFilterSidebar -->
        <!-- BEGIN: BookGridSection -->
        <section class="lg:col-span-3">
          
            <!-- BOOK CARD 1: The Waves -->
             <%if(products.length>0){%>
              <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
             <% products.forEach((product)=>{ %>
              
            <article
              class="bg-[#FDFBF7] border border-[#E3DC CE] rounded p-4 flex flex-col justify-between hover:shadow-md transition-shadow group relative">
              <div class="relative w-full aspect-[4/5] mb-4 bg-[#F2EFE8] rounded flex items-center justify-center p-4 overflow-hidden book-shadow">
                <a href="/product/<%= product._id %>" class="w-full h-full">
                  <div class="absolute inset-y-0 left-0 w-8 book-spine-left pointer-events-none"></div>
                  <img
                    src="<%= product.productImage[0] %>"
                    alt="<%= product.productName %>"
                    class="w-full h-full object-contain rounded">
                </a>
                <!-- Wishlist Icon -->
                <button
                  type="button"
                  class="add-to-wishlist-btn absolute top-3 right-3 z-10 p-2 bg-white rounded-full shadow-sm hover:scale-110 transition-transform"
                  aria-label="Add to wishlist"
                  data-product-id="<%= product._id %>">
                  <svg
                    class="w-5 h-5 stroke-[1.8]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path
                      d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
                      stroke-linecap="round"
                      stroke-linejoin="round">
                    </path>
                  </svg>
                </button>
              </div>
              <!-- Meta details -->
              <div>
                <div class="text-[10px] uppercase font-bold tracking-wider text-[#9E5B32] mb-1">
                  <%= product.category ? product.category.name : 'Uncategorized' %>
                </div>
                <h3
                  class="font-serif font-bold text-lg text-archive-900 group-hover:text-archive-amber transition-colors leading-snug">
                  <%= product.productName %>
                </h3>
                <p class="text-xs text-archive-500 mb-4"><%= product.author %></p>
              </div>
              <div class="flex items-center justify-between pt-3 border-t border-[#EFE9DD]">
                <div class="flex items-baseline space-x-2">
                  <span class="font-medium text-base text-archive-900 font-sans">
                    ₹<%= product.price.toLocaleString('en-IN') %>
                  </span>
                  <!-- <span class="text-xs text-archive-400 line-through">₹2,890</span> -->
                </div>
                <button 
                  type="button" 
                  class="add-to-cart-btn bg-[#1C1A17] hover:bg-black text-white p-2.5 rounded transition" 
                  title="Add to Bag"
                  data-product-id="<%= product._id%>">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" stroke-linecap="round" stroke-linejoin="round">
                    </path>
                  </svg>
                </button>
              </div>
            </article>
            

            <%})%>
            </div>
            <%}else{%>
                <div class="col-span-1 md:col-span-2 xl:col-span-3 bg-[#FDFBF7] border border-[#E3DCCE] rounded-lg p-10 text-center">
                  <div class="flex flex-col items-center gap-3">
                      <i class="text-4xl">📚</i>
                      <h3 class="font-serif text-xl font-bold text-archive-900">
                          No Books Found
                      </h3>
                      <p class="text-sm text-archive-500 max-w-md">
                          We couldn't find any books matching your search or selected filters.
                          Try a different search term or adjust your filters.
                      </p>
                      <a href="/shop"
                          class="mt-2 px-5 py-2 bg-[#1C1A17] text-white text-xs rounded hover:bg-black transition">
                          EXPLORE ALL BOOKS
                      </a>
                  </div>
                </div>
            <%}%>

          <!-- BEGIN: PaginationBar -->
          <div
            class="mt-8 bg-[#FAF7F2] border border-[#DDD5C5] rounded p-3 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
            <div class="flex items-center space-x-2 text-archive-600">
              <svg class="w-4 h-4 text-archive-amber" fill="none" stroke="currentColor" stroke-width="2"
                viewBox="0 0 24 24">
                <path
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                  stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span class="">
                <%
                const startProduct = totalProducts === 0 ? 0 : (currentPage-1)*6+1
                const endProduct = Math.min(currentPage*6, totalProducts)
                %>
                Showing <strong><%= startProduct %>–<%= endProduct %></strong>
                of <strong><%= totalProducts %></strong> curated titles
              </span>
            </div>

            <div class="flex items-center space-x-1 font-medium">
              <!-- Previous button -->
              <% if (currentPage > 1) { %>
              <a
                href="/shop?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search || '') %>&sort=<%= encodeURIComponent(sort) %>&category=<%= encodeURIComponent(selectedCategory || '') %>&author=<%= encodeURIComponent(selectedAuthor || '') %>&priceRange=<%= encodeURIComponent(selectedPriceRange || '') %> "
                class="px-2.5 py-1 text-archive-500 hover:text-archive-900 transition flex items-center">
                ‹ PREVIOUS
              </a>
              <% } else { %>
              <span class="px-2.5 py-1 text-archive-400 flex items-center cursor-not-allowed">
                ‹ PREVIOUS
              </span>
              <% } %>

              <!-- Page numbers -->
              <% for (let i = 1; i <= totalPages; i++) { %>
              <a
                href="/shop?page=<%= i %>&search=<%= encodeURIComponent(search || '') %>&sort=<%= encodeURIComponent(sort) %>&category=<%= encodeURIComponent(selectedCategory || '') %>&author=<%= encodeURIComponent(selectedAuthor || '') %>&priceRange=<%= encodeURIComponent(selectedPriceRange || '') %>"
                class="w-7 h-7 rounded text-xs flex items-center justify-center transition
                <%= currentPage === i
                ? 'bg-[#1C1A17] text-white font-semibold'
                : 'hover:bg-[#EAE3D2] text-archive-800' %>">
                <%= i %>
              </a>
              <% } %>

              <!-- Next button -->
              <% if (currentPage < totalPages) { %>
              <a
                href="/shop?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search || '') %>&sort=<%= encodeURIComponent(sort) %>&category=<%= encodeURIComponent(selectedCategory || '') %>&author=<%= encodeURIComponent(selectedAuthor || '') %>&priceRange=<%= encodeURIComponent(selectedPriceRange || '') %>"
                class="px-2.5 py-1 text-archive-800 hover:text-archive-amber transition flex items-center">
                NEXT ›
              </a>
              <% } else { %>
              <span class="px-2.5 py-1 text-archive-400 flex items-center cursor-not-allowed">
                NEXT ›
              </span>
              <% } %>

            </div>

          </div>
          <!-- END: PaginationBar -->
        </section>
        <!-- END: BookGridSection -->
      </div>
      <!-- END: TwoColumnCatalogLayout -->
    </main>


    <%- include('../partials/user/footer')%>
    <script src="/js/user.js"></script>

</body>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


</html>
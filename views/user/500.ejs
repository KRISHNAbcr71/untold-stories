<!DOCTYPE html>

<html class="scroll-smooth" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>500 - Archival Disruption | The Untold Stories</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Google Fonts for Editorial Aesthetics -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <!-- Tailwind Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        parchment: {
                            50: '#FCFAF7',
                            100: '#FAF7F2',
                            200: '#F5EFEB',
                            300: '#EDE6DD',
                            400: '#E1D7C9',
                        },
                        terracotta: {
                            400: '#C8744B',
                            500: '#B8653B',
                            600: '#A2522B',
                            700: '#8A411E',
                        },
                        ink: {
                            900: '#1A1816',
                            800: '#2B2927',
                            700: '#423F3C',
                            600: '#5C5853',
                            400: '#8C867E',
                        }
                    },
                    fontFamily: {
                        serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- BEGIN: Custom Aesthetics CSS -->
    <style data-purpose="ambient-gradients">
        .parchment-glow {
            background: radial-gradient(circle at 50% 28%, rgba(248, 237, 222, 0.9) 0%, rgba(250, 247, 242, 0.98) 60%, #FAF7F2 100%);
        }

        .watermark-text {
            text-shadow: 0 10px 40px rgba(184, 101, 59, 0.08);
            user-select: none;
        }
    </style>
    <style data-purpose="micro-interactions">
        .btn-archival {
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .btn-archival:hover {
            transform: translateY(-1.5px);
            box-shadow: 0 6px 20px -4px rgba(43, 41, 39, 0.08);
        }
    </style>
    <!-- END: Custom Aesthetics CSS -->
</head>

<body
    class="bg-parchment-100 text-ink-800 font-sans antialiased min-h-screen flex flex-col justify-between selection:bg-terracotta-500 selection:text-white">

    <!-- BEGIN: Main Hero / 500 Archival Disruption Section -->
    <main class="flex-grow flex items-center justify-center parchment-glow py-20 px-6 relative overflow-hidden">
        <!-- Subtle Background Ambient Concentric Lines / Vault Visual -->
        <div class="absolute inset-0 pointer-events-none flex items-center justify-center opacity-30">
            <div class="w-[720px] h-[720px] rounded-full border border-terracotta-400/20"></div>
            <div class="w-[520px] h-[520px] rounded-full border border-terracotta-400/20 absolute"></div>
            <div class="w-[340px] h-[340px] rounded-full border border-terracotta-400/20 absolute"></div>
        </div>
        <div class="max-w-3xl mx-auto text-center relative z-10 flex flex-col items-center">
            <!-- Archival Status Pill Badge -->
            <div
                class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-parchment-200/90 border border-parchment-300/80 mb-6 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-terracotta-500 animate-pulse"></span>
                <span class="text-[11px] font-medium tracking-[0.16em] uppercase text-terracotta-600">
                    Archival Disruption · Error Ref. 500
                </span>
            </div>
            <!-- Layered Typographic 500 Display -->
            <div class="relative w-full flex items-center justify-center mb-6 h-36 select-none">
                <!-- Ethereal Watermark 500 (Behind) -->
                <span
                    class="absolute font-serif italic text-[140px] sm:text-[170px] text-terracotta-400/20 tracking-tighter transform -translate-x-3 -translate-y-2 pointer-events-none font-light watermark-text">
                    500
                </span>
                <!-- Crisp Foreground 500 -->
                <span
                    class="relative font-serif text-[72px] sm:text-[84px] text-ink-900 font-medium tracking-normal z-10">
                    500
                </span>
            </div>
            <!-- Main Headline with Mixed Editorial Styling -->
            <h1 class="font-serif text-3xl sm:text-4xl lg:text-[46px] leading-tight text-ink-900 mb-6 font-normal">
                The Scriptorium Vaults are <br class="hidden sm:inline" />
                <span class="italic text-terracotta-500 font-serif">Momentarily Inaccessible</span>
            </h1>
            <!-- Archival Curatorial Explanation Paragraph -->
            <p class="text-ink-600 text-base sm:text-lg leading-relaxed max-w-2xl font-light mb-10">
                Our archivists and conservators are currently restoring a torn manuscript folio in the core registry.
                The catalog indexing system encountered an unforeseen disruption while binding your reading request.
            </p>
            <!-- Return Button with Clean Archival Border -->
            <div>
                <a class="btn-archival inline-flex items-center gap-2.5 px-7 py-3.5 bg-parchment-200 border border-parchment-300 text-ink-800 hover:text-ink-900 hover:border-terracotta-500/40 hover:bg-parchment-50 text-sm font-medium tracking-wide rounded-md"
                    href="/">
                    <svg class="w-4 h-4 text-ink-700" fill="none" stroke="currentColor" stroke-width="2"
                        viewbox="0 0 24 24">
                        <path d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" stroke-linecap="round" stroke-linejoin="round">
                        </path>
                    </svg>
                    Return to Salon Home
                </a>
            </div>
        </div>
    </main>
    <!-- END: Main Hero / 500 Archival Disruption Section -->
    <%- include('../partials/user/footer')%>
</body>

</html>
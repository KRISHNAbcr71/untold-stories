<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>The Untold Stories - Archival Passkey Recovery &amp; Folio Restoral</title>
  <!-- Tailwind CSS v3 with Forms Plugin -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <!-- Google Fonts: Cormorant Garamond & Plus Jakarta Sans -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700&amp;display=swap"
    rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
          },
          colors: {
            parchment: {
              50: '#FDFCFA',
              100: '#FBF8F3',
              200: '#F5EFEB',
              300: '#EAE1D7',
              400: '#DDD1C3',
            },
            terracotta: {
              500: '#A45D3B',
              600: '#8E4A29',
              700: '#753B1F',
            },
            charcoal: {
              800: '#2A2927',
              900: '#1F1E1D',
              950: '#151413',
            }
          }
        }
      }
    }
  </script>
  <style data-purpose="custom-typography">
    .font-cormorant {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }

    .letter-spacing-wide {
      letter-spacing: 0.18em;
    }

    .letter-spacing-wider {
      letter-spacing: 0.22em;
    }
  </style>
</head>
<%- include('../partials/user/header')%>

  <body class="bg-[#FBF8F3] text-charcoal-900 font-sans antialiased selection:bg-[#EAE1D7] selection:text-charcoal-900">
    <!-- BEGIN: MainContent -->
    <main class="max-w-[1360px] mx-auto px-6 lg:px-12 py-10 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-start">
        <!-- Left Column: Curatorial Narrative & Archival Photography -->
        <section class="lg:col-span-6 flex flex-col justify-start pt-1" data-purpose="narrative-presentation">
          <!-- Protocol Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#EFE8DD] border border-[#DFD5C7] rounded w-fit mb-6">
            <svg class="w-3.5 h-3.5 text-terracotta-600" fill="none" stroke="currentColor" stroke-width="2"
              viewBox="0 0 24 24">
              <path
                d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"
                stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="text-[10px] font-semibold tracking-[0.2em] uppercase text-terracotta-600">CURATORIAL PROTOCOL §
              04</span>
          </div>
          <!-- Headline -->
          <h1
            class="font-serif text-4xl lg:text-[46px] leading-[1.14] text-charcoal-950 font-normal tracking-tight mb-5">
            Custody of the Printed Word &amp;<br class="hidden sm:inline"> Private Folios.
          </h1>
          <!-- Explanatory Copy -->
          <p class="text-[15px] leading-relaxed text-[#5A554E] max-w-xl font-normal mb-8">
            Every patron accession at <em class="font-serif italic font-medium text-charcoal-900">The Untold
              Stories</em> is safeguarded under encrypted archival ledgers. If your cipher key has been misplaced, our
            restorative protocol ensures seamless re-entry into your personal shelf.
          </p>
          <!-- Antique Desk Photography Container -->
          <div class="relative rounded overflow-hidden shadow-sm border border-[#E8DFC0]/60 max-w-lg">
            <img alt="Archival folios, manuscripts, and spectacles resting on an antique oak study desk"
              class="w-full h-[340px] sm:h-[390px] object-cover object-[15%_22%]"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuCDqf23sKW4ARZ9fraR4o5ZLXoFgNlMCYWi6KPr9vWHtI0NXLwgUVhrj86TstvwkadsgGV-F4yIzCtGQAHr6YjjJTzKLHPGu8ByVLM4J93N8UliMJpznOkyIPrrRIlvI30ZRrsXjn1RqR4zHrKlW_kX6_zAe0XozTbeKVoYkgQPrL8rCvaCmESl_FxDa0UwBkNwMIzNqGwZmRRccKSlyLa-J-mRxGYNFIuqihD-E3g17Qc8Po-2TYS0Rw">
            <!-- Floating Ledger Quote Card -->
            <div
              class="absolute bottom-4 left-4 max-w-[275px] bg-[#FAF6F0]/95 backdrop-blur-sm p-4 border border-[#E2D5C3] shadow-md rounded-sm">
              <p class="font-serif italic text-charcoal-950 text-base leading-snug mb-3">
                “A key once lost is only awaiting the quiet discernment of memory.”
              </p>
              <div
                class="flex items-center justify-between text-[9px] tracking-[0.16em] uppercase font-bold text-[#86593F]">
                <span class="">KEEPER'S LEDGER</span>
                <span class="text-[#8C847B] font-normal tracking-wider">Folio 1892</span>
              </div>
            </div>
          </div>
        </section>
        <!-- Right Column: Passkey Recovery Form Card -->
        <section class="lg:col-span-6 flex justify-end" data-purpose="recovery-card-wrapper">
          <div
            class="w-full max-w-[530px] bg-white rounded-lg border border-[#EDE4D8] p-8 sm:p-10 shadow-[0_12px_36px_-6px_rgba(40,30,20,0.06)]"
            data-purpose="archival-recovery-card">
            <!-- Card Top Bar Labels -->
            <div class="flex items-center justify-between border-b border-transparent pb-1 mb-4">
              <span
                class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[10px] font-bold tracking-[0.18em] uppercase bg-[#F2EAE0] text-terracotta-600">
                <span class="w-1.5 h-1.5 rounded-full bg-terracotta-600"></span>
                ARCHIVAL PASSKEY RECOVERY
              </span>
              <span class="text-[10px] font-semibold tracking-[0.2em] uppercase text-[#A39A8F]">
                FOLIO RESTORAL
              </span>
            </div>
            <!-- Card Main Title -->
            <h2
              class="font-serif text-[34px] sm:text-[38px] leading-tight font-normal text-charcoal-950 mb-3 tracking-tight">
              Forgot Your Password?
            </h2>
            <p class="text-[13.5px] leading-relaxed text-[#6B635A] mb-8">
              Enter the registered email associated with your reader archive account. We will dispatch a 6–digit
              recovery passkey or secure link to restore your vault access.
            </p>
            <!-- Recovery Form -->
            <form action="/forgot-password" class="space-y-6" data-purpose="recovery-form" method="POST" novalidate>
              <% if(typeof message !=='undefined' && message) {%>
                <div id="recovery-message"
                  class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-md px-4 py-3"
                  role="status">
                  <%= message%>
                </div>
                <%}%>
                  <!-- Email Input Field -->
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <label
                        class="flex items-center gap-1.5 text-[11px] font-bold tracking-[0.16em] uppercase text-charcoal-900"
                        for="email">
                        <svg class="w-3.5 h-3.5 text-terracotta-600" fill="none" stroke="currentColor" stroke-width="2"
                          viewBox="0 0 24 24">
                          <path
                            d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                            stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                        ACCOUNT EMAIL ADDRESS
                      </label>
                      <span class="text-[11px] font-medium text-terracotta-600 tracking-wide">Patron Identity</span>
                    </div>
                    <!-- Input Group -->
                    <div
                      class="relative rounded bg-[#FBF9F6] border border-[#E3D9CC] focus-within:border-charcoal-800 transition-colors">
                      <div
                        class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-charcoal-800 font-medium">
                        <span class="text-sm font-sans text-charcoal-900">@</span>
                      </div>
                      <input
                        class="w-full bg-transparent border-0 pl-9 pr-4 py-3 text-sm text-charcoal-950 placeholder-[#797268] focus:ring-0 focus:outline-none"
                        id="email" name="email" placeholder="e.g. eleanor.vance@archival.org" required type="email">
                    </div>
                    <p id="email-error" class="mt-2 text-xs text-red-600 hidden"></p>
                    <!-- Helper notice below input -->
                    <div class="flex items-center gap-1.5 mt-2.5 text-xs text-[#7A7268]">
                      <svg class="w-3.5 h-3.5 text-charcoal-700 flex-shrink-0" fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 8.25v.01M12 11.25v4.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                      <span class="">A one-time verification cipher will be sent immediately.</span>
                    </div>
                  </div>
                  <!-- Submit Button -->
                  <button
                    class="w-full bg-charcoal-900 hover:bg-black text-white font-semibold text-xs tracking-[0.2em] uppercase py-3.5 px-6 rounded transition-colors flex items-center justify-center gap-2 group shadow-sm"
                    type="submit">
                    <span class="">SEND RECOVERY PASSKEY</span>
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none"
                      stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" stroke-linecap="round" stroke-linejoin="round">
                      </path>
                    </svg>
                  </button>
            </form>
            <!-- Curator Assistance Callout -->
            <div class="mt-8 p-5 bg-[#FAF6F0] border border-[#E9E0D3] rounded flex gap-4"
              data-purpose="curator-callout">
              <div class="flex-shrink-0 text-terracotta-600 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z"
                    stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
              <div>
                <p class="font-serif italic text-charcoal-950 text-[14.5px] leading-snug mb-2">
                  “Should you encounter difficulty retrieving access to your private shelves, our Edinburgh desk retains
                  physical appraisal cards for direct identity attestation.”
                </p>
                <span class="block text-[10px] uppercase font-bold tracking-[0.16em] text-terracotta-600">
                  — DESK CURATOR M. ALTHAUS, GREENWICH &amp; EDINBURGH ARCHIVES
                </span>
              </div>
            </div>
            <!-- Bottom Links Section -->
            <div
              class="mt-7 pt-4 border-t border-[#F2ECE4] flex flex-wrap items-center justify-between text-xs text-[#6B635A] gap-3">
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-charcoal-700" fill="none" stroke="currentColor" stroke-width="2"
                  viewBox="0 0 24 24">
                  <path d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span class="">Remember your password?</span>
                <a class="font-semibold text-charcoal-900 underline hover:text-terracotta-600 transition-colors ml-0.5"
                  href="/login">Log In</a>
              </div>
              <div>
                <span class="">Need an account?</span>
                <a class="font-semibold text-charcoal-900 underline hover:text-terracotta-600 transition-colors ml-1"
                  href="/signup">Register</a>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>
    <!-- END: MainContent -->
    <%- include('../partials/user/footer')%>

      <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
      
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success',
            text: <%- JSON.stringify(successMessage) %>,
            confirmButtonColor: '#8E4A29'
        }).then(() => {
            window.location.href = '/verify-forgot-password-otp';
        });
    </script>
    <% } %>

  </body>


  <script>
    const recoveryForm = document.querySelector('[data-purpose="recovery-form"]')
    const emailInput = document.getElementById('email')
    const emailError = document.getElementById('email-error')

    recoveryForm.addEventListener('submit',(event)=>{
      const email = emailInput.value.trim()
      emailError.textContent = ''
      emailError.classList.add('hidden')

      if(!email){
        event.preventDefault()
        emailError.textContent = 'Please enter your email address'
        emailError.classList.remove('hidden')
        return
      }

      if(!emailInput.checkValidity()){
        event.preventDefault()
        emailError.textContent = 'Please enter a valid emain address'
        emailError.classList.remove('hidden')
      }

    })

    emailInput.addEventListener('input',()=>{
      emailError.textContent = ''
      emailError.classList.add('hidden')
    })




    const recoveryMessage = document.getElementById('recovery-message')
    emailInput.addEventListener('input',()=>{
      if(recoveryMessage){
        recoveryMessage.remove()
      }
    })


  </script>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Create Your Reader Account | The Untold Stories</title>
    <!-- Tailwind CSS CDN with Forms & Container Queries -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Google Fonts: Cormorant Garamond & Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700&amp;display=swap"
        rel="stylesheet">
    <!-- Custom Tailwind Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        parchment: '#FAF8F5',
                        'parchment-deep': '#F4EFEA',
                        'field-bg': '#F6F3EE',
                        'bronze-accent': '#9E5836',
                        'bronze-hover': '#864728',
                        'ink-black': '#21201E',
                        'ink-muted': '#6B6661',
                        'border-subtle': '#E8E2D9'
                    },
                    fontFamily: {
                        serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style data-purpose="typography">
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #FAF8F5;
            color: #21201E;
        }

        .font-literary {
            font-family: 'Cormorant Garamond', Georgia, serif;
        }
    </style>
    <style data-purpose="custom-shadows">
        .card-shadow {
            box-shadow: 0 20px 45px -15px rgba(50, 40, 30, 0.08), 0 0 1px 1px rgba(60, 45, 30, 0.04);
        }
    </style>
</head>
<%- include('../partials/user/header')%>
<body
    class="bg-[#FAF7F0] text-ink-black min-h-screen flex flex-col antialiased selection:bg-[#9E5836]/15 selection:text-[#9E5836]">
    
    <!-- BEGIN: MainContent -->
    <main class="flex-grow flex items-center justify-center px-4 sm:px-6 py-10 lg:py-16"
        data-purpose="registration-section">
        <!-- Card Container -->
        <div
            class="w-full max-w-[1040px] bg-white rounded-2xl border border-[#EDE8E1] card-shadow overflow-hidden grid grid-cols-1 lg:grid-cols-12 min-h-[750px]">
            <!-- Left Column: Sanctuary Register & Archival Showcase -->
            <div class="lg:col-span-5 bg-[#FBF9F6] p-8 sm:p-10 border-b lg:border-b-0 lg:border-r border-[#ECE6DE] flex flex-col justify-between"
                data-purpose="editorial-column">
                <div>
                    <!-- Eyebrow Pill -->
                    <div
                        class="inline-flex items-center gap-2 text-bronze-accent mb-6 font-semibold tracking-wider text-[11px] uppercase">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path
                                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                                stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                        </svg>
                        <span class="">Sanctuary Register</span>
                    </div>
                    <!-- Headline -->
                    <h1 class="font-literary text-3xl sm:text-4xl lg:text-[42px] leading-[1.12] text-[#1E1C1A] mb-4">
                        An intimate gateway to archival treasures.
                    </h1>
                    <!-- Description -->
                    <p class="text-sm text-[#666059] leading-relaxed mb-8 font-light">
                        Curated first editions, letterpress imprints, and restoration chronicles reserved for our
                        discerning fellowship.
                    </p>
                    <!-- Archival Image Card -->
                    <div class="relative rounded-lg overflow-hidden border border-[#E6E0D6] shadow-sm mb-6 group">
                        <img alt="Antique leather-bound rare book on study table with magnifying glass"
                            class="w-full h-52 sm:h-56 object-cover object-center transition-transform duration-700 group-hover:scale-105"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuB6TlFiL1h4x09EtgbOxrb5zb1kO-XXyOsB48H0zeTLrbx2QG3gbd8TXC8XcxGxIEpsHfiW3FYen7pBz9ZVlBnr4vIAHVrsHyJHejc8KJ4mwibEX09YYZ3LuNtsZMhMdWLU8enCjnu2UOeQWoDG8KNDZN04cM1nxEoPGRNUm4E6OI-gj64R1CuaTXlCBCoOpMBizbh2Q7LkpgKFED0uvfTrv1xE4S2SYS8b4mpWlmpw0-YZrsPI3hLzRg">
                        <!-- Folio Registry Pill -->
                        <div
                            class="absolute bottom-3 left-3 bg-[#1D1B1A]/85 backdrop-blur-sm text-[#F7F4EE] px-3 py-1 rounded text-[10px] font-mono tracking-wider font-medium">
                            FOLIO REGISTRY NO. 1894-B
                        </div>
                    </div>
                </div>
                <!-- Privilege Badge Footer inside left col -->
                <div class="pt-4 border-t border-[#EDE6DC]">
                    <div class="flex items-start gap-2.5">
                        <span class="text-bronze-accent mt-0.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path
                                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                    stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                            </svg>
                        </span>
                        <div>
                            <span
                                class="block text-[11px] uppercase tracking-wider font-semibold text-bronze-accent mb-0.5">Reader
                                Privileges</span>
                            <p class="text-xs text-[#706B65] leading-relaxed">Early acquisitions access, quarterly
                                printed broadsides, and private book appraisal consultations.</p>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Right Column: Enrollment Form -->
            <div class="lg:col-span-7 bg-white p-8 sm:p-12 flex flex-col justify-center"
                data-purpose="signup-form-column">
                <div class="max-w-[460px] mx-auto w-full">
                    <!-- Form Header -->
                    <div class="mb-7">
                        <span
                            class="text-[11px] uppercase tracking-[0.18em] font-semibold text-bronze-accent block mb-2">Member
                            Enrollment</span>
                        <h2 class="font-literary text-3xl sm:text-[36px] font-bold text-[#1E1C1A] leading-tight mb-2.5">
                            Create Your Reader Account</h2>
                        <p class="text-[13px] text-[#69635C] leading-normal font-light">Join our sanctuary of rare
                            editions, private vault previews, and literary archives.</p>
                    </div>
                    <!-- Input Fields Form -->
                    <form class="space-y-4" action="/signup" method="post" novalidate>
                        <% if(typeof message !== 'undefined' && message){%>
                            <div id="error-message" class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-md px-4 py-3">
                                <%= message%>
                            </div>
                            <%}%>
                        <!-- Full Name -->
                        <div>
                            <label class="block text-[10px] uppercase font-bold tracking-wider text-[#4A4540] mb-1.5"
                                for="fullName">Full Name</label>
                            <div class="relative rounded-md shadow-none">
                                <div
                                    class="absolute top-0 left-0 h-[42px] pl-3.5 flex items-center pointer-events-none text-[#8A847C]">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                                            stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
                                    </svg>
                                </div>
                                <input
                                    class="block w-full pl-10 pr-3 py-2.5 bg-[#F6F3EE] border-0 text-[#24211D] placeholder-[#6E675E] text-sm rounded focus:ring-1 focus:ring-bronze-accent"
                                    id="fullName" name="name" placeholder="Eleanor Vance" type="text" value="<%= typeof name !== 'undefined' ? name : '' %>">
                                <p id="nameError" class="text-red-600 text-sm mt-1"></p>
                            </div>
                        </div>
                        <!-- Email Address -->
                        <div>
                            <label class="block text-[10px] uppercase font-bold tracking-wider text-[#4A4540] mb-1.5"
                                for="email">Email Address</label>
                            <div class="relative rounded-md shadow-none">
                                <div
                                    class="absolute top-0 left-0 h-[42px] pl-3.5 flex items-center pointer-events-none text-[#8A847C]">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                            stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
                                    </svg>
                                </div>
                                <input
                                    class="block w-full pl-10 pr-3 py-2.5 bg-[#F6F3EE] border-0 text-[#24211D] placeholder-[#6E675E] text-sm rounded focus:ring-1 focus:ring-bronze-accent"
                                    id="email" name="email" placeholder="name@domain.com" type="email">
                                <p id="emailError" class="text-red-600 text-sm mt-1"></p>
                            </div>
                        </div>
                        <!-- Phone Number -->
                        <div>
                            <label class="block text-[10px] uppercase font-bold tracking-wider text-[#4A4540] mb-1.5"
                                for="phone">Phone Number</label>
                            <div class="relative rounded-md shadow-none">
                                <div
                                    class="absolute top-0 left-0 h-[42px] pl-3.5 flex items-center pointer-events-none text-[#8A847C]">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                            stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
                                    </svg>
                                </div>
                                <input
                                    class="block w-full pl-10 pr-3 py-2.5 bg-[#F6F3EE] border-0 text-[#24211D] placeholder-[#6E675E] text-sm rounded focus:ring-1 focus:ring-bronze-accent"
                                    id="phone" name="phone" placeholder="98765 43210" type="tel" value="<%= typeof name !== 'undefined' ? phone : '' %>">
                                <p id="phoneError" class="text-red-600 text-sm mt-1"></p>
                            </div>
                        </div>
                        <!-- Password -->
                        <div>
                            <label class="block text-[10px] uppercase font-bold tracking-wider text-[#4A4540] mb-1.5"
                                for="password">Password</label>
                            <div class="relative rounded-md shadow-none">
                                <div
                                    class="absolute top-0 left-0 h-[42px] pl-3.5 flex items-center pointer-events-none text-[#8A847C]">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                                            stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
                                    </svg>
                                </div>
                                <input
                                    class="block w-full pl-10 pr-10 py-2.5 bg-[#F6F3EE] border-0 text-[#24211D] tracking-widest text-sm rounded focus:ring-1 focus:ring-bronze-accent"
                                    id="password" name="password" type="password" placeholder="●●●●●●●●" minlength="8" autocomplete="new-password" required>
                                <p id="passwordError" class="text-red-600 text-sm mt-1"></p>
                                <button
                                    class="absolute top-0 right-0 h-[42px] pr-3.5 flex items-center text-[#8A847C] hover:text-ink-black"
                                    type="button" id="togglePassword">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round"
                                            stroke-linejoin="round" stroke-width="1.8"></path>
                                        <path
                                            d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                                            stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <!-- Confirm Password -->
                        <div>
                            <label class="block text-[10px] uppercase font-bold tracking-wider text-[#4A4540] mb-1.5"
                                for="confirmPassword">Confirm Password</label>
                            <div class="relative rounded-md shadow-none">
                                <div
                                    class="absolute top-0 left-0 h-[42px] pl-3.5 flex items-center pointer-events-none text-[#8A847C]">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                                            stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
                                    </svg>
                                </div>
                                <input
                                    class="block w-full pl-10 pr-10 py-2.5 bg-[#F6F3EE] border-0 text-[#24211D] tracking-widest text-sm rounded focus:ring-1 focus:ring-bronze-accent"
                                    id="confirmPassword" name="confirmPassword" type="password" placeholder="●●●●●●●●" autocomplete="new-password" required>
                                <p id="confirmPasswordError" class="text-red-600 text-sm mt-1"></p>
                                <button
                                    class="absolute top-0 right-0 h-[42px] pr-3.5 flex items-center text-[#8A847C] hover:text-ink-black"
                                    type="button">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round"
                                            stroke-linejoin="round" stroke-width="1.8"></path>
                                        <path
                                            d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                                            stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <!-- Primary Signup Button -->
                        <button
                            class="w-full mt-2 bg-[#2B2826] hover:bg-black text-white font-medium py-3 rounded text-xs uppercase tracking-widest flex items-center justify-center gap-2 transition-all shadow hover:shadow-md"
                            type="submit">
                            <span class="">Signup</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round"
                                    stroke-width="2"></path>
                            </svg>
                        </button>
                    </form>
                    <!-- Login Link -->
                    <div class="text-center mt-4">
                        <span class="text-xs text-[#706B65]">Already have an account? </span>
                        <a class="text-xs font-semibold text-bronze-accent hover:underline" href="#">Login</a>
                    </div>
                    <!-- Divider -->
                    <div class="relative my-4">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-[#EAE3D8]"></div>
                        </div>
                        <div class="relative flex justify-center text-[10px] uppercase tracking-widest">
                            <span class="bg-white px-3 text-[#9A948C]">OR</span>
                        </div>
                    </div>
                    <!-- Google Sign In Button -->
                    <a href="/auth/google" 
                        class="w-full py-2.5 px-4 bg-[#F6F3EE] hover:bg-[#EFE9E0] text-[#332F2B] text-xs font-medium rounded flex items-center justify-center gap-2.5 transition-colors border border-transparent">
                        <!-- Google Multicolored SVG Icon -->
                        <svg class="w-4 h-4" viewBox="0 0 24 24">
                            <path
                                d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.65v3.03h3.88c2.27-2.09 3.665-5.17 3.665-9.12z"
                                fill="#4285F4"></path>
                            <path
                                d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.03c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.13C3.26 21.36 7.33 24 12 24z"
                                fill="#34A853"></path>
                            <path
                                d="M5.28 14.29c-.25-.72-.38-1.49-.38-2.29s.13-1.57.38-2.29V6.58H1.25C.45 8.18 0 10.03 0 12s.45 3.82 1.25 5.42l4.03-3.13z"
                                fill="#FBBC05"></path>
                            <path
                                d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.13c.95-2.83 3.6-4.96 6.72-4.96z"
                                fill="#EA4335"></path>
                        </svg>
                        <span class="">Sign up with Google</span>
                    </a>
                    <!-- Disclaimer Footnote -->
                    <p class="text-[11px] text-center text-[#8C857D] mt-6 leading-relaxed">
                        By creating an account, you consent to our Archival Charter and Provenance Guarantee.
                    </p>
                </div>
            </div>
        </div>
    </main>
    <!-- END: MainContent -->
    <%- include('../partials/user/footer')%>

</body>

<script>
    const signupForm = document.querySelector('form')

    const fullName = document.getElementById('fullName')
    const nameError = document.getElementById('nameError')

    const email = document.getElementById('email')
    const emailError = document.getElementById('emailError')

    const phone = document.getElementById('phone')
    const phoneError = document.getElementById('phoneError')

    const password = document.getElementById('password')
    const passwordError = document.getElementById('passwordError')

    const confirmPassword = document.getElementById('confirmPassword')
    const confirmPasswordError = document.getElementById('confirmPasswordError')

    signupForm.addEventListener('submit',(event)=>{
        const nameValue = fullName.value.trim() 
        const emailValue = email.value.trim()
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
        const phoneValue = phone.value.trim()
        const passwordValue = password.value
        const passwordPattern =  /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9\s])\S{8,}$/
        const confirmPasswordValue = confirmPassword.value

        if(nameValue === ''){
            event.preventDefault()
            nameError.textContent = 'Full name is required'
        }else{
            nameError.textContent = ""
        }


        if(emailValue === ''){
            event.preventDefault()
            emailError.textContent = 'Email is required'
        }else if(!emailPattern.test(emailValue)){
            event.preventDefault()
            emailError.textContent = 'Please enter a valid email address'
        }else{
            emailError.textContent = ''
        }


        if(phoneValue === ''){
            event.preventDefault()
            phoneError.textContent = 'Phone number is required'
        }else if(phoneValue.length !== 10 || isNaN(phoneValue)){
            event.preventDefault()
            phoneError.textContent = 'Enter a valid 10-digit mobile number'
        }else{
            phoneError.textContent = ''
        }

        if(passwordValue === ''){
            event.preventDefault()
            passwordError.textContent = 'Password is required'
        }else if(!passwordPattern.test(passwordValue)){
            event.preventDefault()
            passwordError.textContent = 'Use at least 8 characters with uppercase, lowercase, a number and a special character. Spaces are not allowed'
        }else{
            passwordError.textContent = ''
        }

        if(confirmPasswordValue === ''){
            event.preventDefault()
            confirmPasswordError.textContent = 'Please confirm your password'
        }else if(confirmPasswordValue !== passwordValue){
            event.preventDefault()
            confirmPasswordError.textContent = 'Passwords do not match'
        }else{
            confirmPasswordError.textContent = ''
        }

    })

    

    fullName.addEventListener('input', () =>{
        nameError.textContent = ''
    })

    email.addEventListener('input', () =>{
        emailError.textContent = ''
    })

    phone.addEventListener('input',()=>{
        phoneError.textContent = ''
    })

    password.addEventListener('input', () => {
    passwordError.textContent = ''
    confirmPasswordError.textContent = ''
    })





    // password visibility button
    const togglePassword = document.getElementById('togglePassword')
    togglePassword.addEventListener('click', () =>{
        if(password.type === 'password'){
            password.type = 'text'
        }else{
            password.type = 'password'
        }
    })


    const toggleConfirmPassword = confirmPassword.parentElement.querySelector('button')
    toggleConfirmPassword.addEventListener('click',()=>{
        if(confirmPassword.type === 'password'){
            confirmPassword.type = 'text'
        }else{
            confirmPassword.type = 'password'
        }
    })



    const errorMessage = document.getElementById('error-message')
    email.addEventListener('click', ()=>{
        if(errorMessage){
            errorMessage.remove()
        }
    })


</script>

</html>
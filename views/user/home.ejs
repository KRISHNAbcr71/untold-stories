  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            parchment: {
              50: '#FDFBF7',
              100: '#FAF6EE',
              200: '#F5ECE0',
              300: '#EADECB',
            },
            terracotta: {
              500: '#C25E34',
              600: '#A6461D',
              700: '#8C3512',
            },
            ink: {
              800: '#2A2421',
              900: '#1A1615',
            }
          }
        }
      }
    }
  </script>

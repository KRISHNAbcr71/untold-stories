<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Dashboard - The Untold Stories Admin</title>
<!-- Tailwind CSS CDN -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- Google Fonts: Cormorant Garamond & Plus Jakarta Sans -->
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<!-- Tailwind Configuration -->
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            parchment: {
              50: '#fdfbf7',
              100: '#f7f3eb',
              200: '#efe8db',
              300: '#e3d8c4',
            },
            antique: {
              900: '#1e1c19',
              800: '#2b2723',
              700: '#3f3a34',
              600: '#5c544c',
              500: '#7a7065',
              400: '#9e9386',
              300: '#c5baa9',
              200: '#e0d8cc',
              100: '#ede8df',
            }
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'ui-sans-serif', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>
<!-- Base Custom Styles -->
<style data-purpose="custom-typography">
    body {
      background-color: #f7f3ea;
      color: #2b2723;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .font-editorial {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-[#f7f3ea] text-[#2b2723] antialiased selection:bg-[#e0d8cc] selection:text-[#1e1c19]">
<!-- BEGIN: MainHeader -->
<header class="w-full bg-[#f7f3ea]/90 border-b border-[#e9e2d3] sticky top-0 z-30 backdrop-blur-sm">
<div class="max-w-7xl mx-auto px-6 lg:px-10 h-20 flex items-center justify-between">
<!-- Brand Logo & Identity -->
<div class="flex items-center space-x-3.5" data-purpose="brand-identity">
<!-- Folio Icon Badge -->
<div class="w-10 h-10 rounded-xl bg-[#eee8dc] border border-[#dfd7c7] flex items-center justify-center text-[#2b2723] shadow-sm">
<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewbox="0 0 24 24">
<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
<path d="M6 6h10"></path>
<path d="M6 10h10"></path>
<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
</svg>
</div>
<!-- Brand Names -->
<div class="flex flex-col">
<span class="font-editorial text-xl font-semibold tracking-tight text-[#1e1c19] leading-tight">The Untold Stories</span>
<span class="text-[9px] font-semibold tracking-[0.2em] text-[#85796b] uppercase">Rare Editions &amp; Literary Archive</span>
</div>
</div>
<!-- Navigation Links -->
<nav class="hidden md:flex items-center space-x-8 text-sm" data-purpose="main-nav">
<!-- Active Link -->
<a class="relative text-[#1e1c19] font-medium py-7 after:content-[''] after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[2px] after:bg-[#6b5842] after:rounded-full" href="#dashboard">
          Dashboard
        </a>
<a class="text-[#685f53] hover:text-[#1e1c19] font-medium transition-colors py-7" href="#products">
          Products
        </a>
<a class="text-[#685f53] hover:text-[#1e1c19] font-medium transition-colors py-7" href="#categories">
          Categories
        </a>
<a class="text-[#685f53] hover:text-[#1e1c19] font-medium transition-colors py-7" href="#orders">
          Orders
        </a>
<a class="text-[#685f53] hover:text-[#1e1c19] font-medium transition-colors py-7" href="#customers">
          Customers
        </a>
</nav>
<!-- Admin Profile Controls -->
<div class="flex items-center" data-purpose="user-menu">
<button class="group flex items-center space-x-2 text-sm text-[#463f35] hover:text-[#1e1c19] transition-colors focus:outline-none" type="button">
<svg class="w-4 h-4 text-[#5c5346] group-hover:text-[#1e1c19]" fill="none" stroke="currentColor" stroke-width="1.8" viewbox="0 0 24 24">
<path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span class="font-normal">Admin</span>
<svg class="w-3.5 h-3.5 text-[#736859] transition-transform duration-200 group-hover:translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<path d="M19.5 8.25l-7.5 7.5-7.5-7.5" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</button>
</div>
</div>
</header>
<!-- END: MainHeader -->
<!-- BEGIN: MainContent -->
<main class="flex-1 max-w-7xl w-full mx-auto px-6 lg:px-10 pt-10 pb-16">
<!-- BEGIN: DashboardHeader -->
<div class="mb-10" data-purpose="page-title-banner">
<!-- Breadcrumb / Eyebrow -->
<p class="text-[11px] font-semibold tracking-[0.22em] text-[#8a7e70] uppercase mb-1">
        Administration / Overview
      </p>
<!-- Heading Row -->
<div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-4">
<div>
<h1 class="font-editorial text-5xl md:text-[54px] font-normal tracking-tight text-[#1c1a17] leading-none mb-3">
            Dashboard
          </h1>
<p class="text-sm text-[#73695d]">
            Welcome to your bookstore administration panel.
          </p>
</div>
<!-- Store Front External Link Pill -->
<div class="self-start sm:self-auto">
<a class="inline-flex items-center px-4 py-1.5 rounded-full border border-[#ded5c5] bg-[#faf7f2] hover:bg-white text-xs font-normal text-[#4d4439] hover:text-[#1e1c19] shadow-sm transition duration-150 ease-in-out" href="#">
            The Untold Stories
          </a>
</div>
</div>
</div>
<!-- END: DashboardHeader -->
<!-- BEGIN: MetricCardsGrid -->
<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8" data-purpose="metrics-overview">
<!-- Metric Card 1: Total Products -->
<div class="bg-white rounded-2xl p-6 border border-[#ece6d9] shadow-[0_2px_12px_-4px_rgba(40,30,20,0.04)] flex flex-col justify-between min-h-[178px] hover:border-[#dfd7c5] transition-all">
<div class="flex items-start justify-between">
<h2 class="text-sm font-normal text-[#574e44]">Total Products</h2>
<div class="w-9 h-9 rounded-full bg-[#f6f2ea] border border-[#eee8db] flex items-center justify-center text-[#5c5246] shrink-0">
<!-- Book Icon -->
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewbox="0 0 24 24">
<rect height="16" rx="2" stroke-linecap="round" stroke-linejoin="round" width="14" x="5" y="4"></rect>
<line stroke-linecap="round" x1="8" x2="16" y1="16" y2="16"></line>
</svg>
</div>
</div>
<div>
<div class="text-2xl font-light text-[#221f1c] my-3">—</div>
<p class="text-xs text-[#8c8072]">Book inventory overview</p>
</div>
</div>
<!-- Metric Card 2: Total Categories -->
<div class="bg-white rounded-2xl p-6 border border-[#ece6d9] shadow-[0_2px_12px_-4px_rgba(40,30,20,0.04)] flex flex-col justify-between min-h-[178px] hover:border-[#dfd7c5] transition-all">
<div class="flex items-start justify-between">
<h2 class="text-sm font-normal text-[#574e44]">Total Categories</h2>
<div class="w-9 h-9 rounded-full bg-[#f6f2ea] border border-[#eee8db] flex items-center justify-center text-[#5c5246] shrink-0">
<!-- 4-Squares Grid Icon -->
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewbox="0 0 24 24">
<rect height="6" rx="1" width="6" x="4" y="4"></rect>
<rect height="6" rx="1" width="6" x="14" y="4"></rect>
<rect height="6" rx="1" width="6" x="4" y="14"></rect>
<rect height="6" rx="1" width="6" x="14" y="14"></rect>
</svg>
</div>
</div>
<div>
<div class="text-2xl font-light text-[#221f1c] my-3">—</div>
<p class="text-xs text-[#8c8072]">Organized collections</p>
</div>
</div>
<!-- Metric Card 3: Total Orders -->
<div class="bg-white rounded-2xl p-6 border border-[#ece6d9] shadow-[0_2px_12px_-4px_rgba(40,30,20,0.04)] flex flex-col justify-between min-h-[178px] hover:border-[#dfd7c5] transition-all">
<div class="flex items-start justify-between">
<h2 class="text-sm font-normal text-[#574e44]">Total Orders</h2>
<div class="w-9 h-9 rounded-full bg-[#f6f2ea] border border-[#eee8db] flex items-center justify-center text-[#5c5246] shrink-0">
<!-- Shopping Bag Icon -->
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewbox="0 0 24 24">
<path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
</div>
<div>
<div class="text-2xl font-light text-[#221f1c] my-3">—</div>
<p class="text-xs text-[#8c8072]">Customer purchases</p>
</div>
</div>
<!-- Metric Card 4: Total Customers -->
<div class="bg-white rounded-2xl p-6 border border-[#ece6d9] shadow-[0_2px_12px_-4px_rgba(40,30,20,0.04)] flex flex-col justify-between min-h-[178px] hover:border-[#dfd7c5] transition-all">
<div class="flex items-start justify-between">
<h2 class="text-sm font-normal text-[#574e44]">Total Customers</h2>
<div class="w-9 h-9 rounded-full bg-[#f6f2ea] border border-[#eee8db] flex items-center justify-center text-[#5c5246] shrink-0">
<!-- Customer / Users Icon -->
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewbox="0 0 24 24">
<path d="M18 19c0-2.21-2.686-4-6-4s-6 1.79-6 4" stroke-linecap="round" stroke-linejoin="round"></path>
<circle cx="12" cy="9" r="3" stroke-linecap="round" stroke-linejoin="round"></circle>
<path d="M19 8a2.5 2.5 0 010 5" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
</div>
<div>
<div class="text-2xl font-light text-[#221f1c] my-3">—</div>
<p class="text-xs text-[#8c8072]">Registered accounts</p>
</div>
</div>
</section>
<!-- END: MetricCardsGrid -->
<!-- BEGIN: WorkspaceCard -->
<section class="bg-white rounded-2xl p-8 sm:p-10 border border-[#ece6d9] shadow-[0_2px_12px_-4px_rgba(40,30,20,0.04)]" data-purpose="workspace-overview">
<div class="max-w-3xl">
<!-- Eyebrow -->
<p class="text-[11px] font-semibold tracking-[0.2em] text-[#8e8274] uppercase mb-2">
          Your Workspace
        </p>
<!-- Section Headline -->
<h2 class="font-editorial text-3xl sm:text-4xl text-[#1e1c19] font-normal tracking-tight mb-4">
          Manage your bookstore
        </h2>
<!-- Descriptive Copy -->
<p class="text-sm sm:text-base text-[#685e52] leading-relaxed font-normal">
          Use the administration panel to manage books, organize categories, review orders, and oversee customer accounts. Dashboard statistics will appear here once connected to the database.
        </p>
</div>
</section>
<!-- END: WorkspaceCard -->
</main>
<!-- END: MainContent -->
<!-- BEGIN: MainFooter -->
<footer class="w-full max-w-7xl mx-auto px-6 lg:px-10 py-6 border-t border-[#ede7da]/60">
<div class="flex items-center text-xs text-[#8c8072]">
<span>© 2026 The Untold Stories</span>
<span class="mx-2">·</span>
<span>Admin Panel</span>
</div>
</footer>
<!-- END: MainFooter -->
</body></html>
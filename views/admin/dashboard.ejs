<!DOCTYPE html>

<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Dashboard - The Untold Stories Admin</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <!-- Google Fonts: Cormorant Garamond & Plus Jakarta Sans -->
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap"
    rel="stylesheet" />
  <!-- Tailwind Configuration -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            parchment: {
              50: '#fdfbf7',
              100: '#f7f3eb',
              200: '#efe8db',
              300: '#e3d8c4',
            },
            antique: {
              900: '#1e1c19',
              800: '#2b2723',
              700: '#3f3a34',
              600: '#5c544c',
              500: '#7a7065',
              400: '#9e9386',
              300: '#c5baa9',
              200: '#e0d8cc',
              100: '#ede8df',
            }
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'ui-sans-serif', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <!-- Base Custom Styles -->
  <style data-purpose="custom-typography">
    body {
      background-color: #f7f3ea;
      color: #2b2723;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .font-editorial {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }
  </style>
</head>

<%- include('../partials/admin/header')%>
<body
  class="min-h-screen flex flex-col bg-[#f7f3ea] text-[#2b2723] antialiased selection:bg-[#e0d8cc] selection:text-[#1e1c19]">

  <!-- BEGIN: MainContent -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-6 lg:px-10 pt-10 pb-16">
    <!-- BEGIN: DashboardHeader -->
    <div class="mb-10" data-purpose="page-title-banner">
      <!-- Breadcrumb / Eyebrow -->
      <p class="text-[11px] font-semibold tracking-[0.22em] text-[#8a7e70] uppercase mb-1">
        Administration / Overview
      </p>
      <!-- Heading Row -->
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-4">
        <div>
          <h1
            class="font-editorial text-5xl md:text-[54px] font-normal tracking-tight text-[#1c1a17] leading-none mb-3">
            Dashboard
          </h1>
          <p class="text-sm text-[#73695d]">
            Welcome to your bookstore administration panel.
          </p>
        </div>
        <!-- Store Front External Link Pill -->
        <div class="self-start sm:self-auto">
          <a class="inline-flex items-center px-4 py-1.5 rounded-full border border-[#ded5c5] bg-[#faf7f2] hover:bg-white text-xs font-normal text-[#4d4439] hover:text-[#1e1c19] shadow-sm transition duration-150 ease-in-out"
            href="#">
            The Untold Stories
          </a>
        </div>
      </div>
    </div>
    <!-- END: DashboardHeader -->
    <!-- BEGIN: MetricCardsGrid -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8" data-purpose="metrics-overview">
      <!-- Metric Card 1: Total Products -->
      <div
        class="bg-white rounded-2xl p-6 border border-[#ece6d9] shadow-[0_2px_12px_-4px_rgba(40,30,20,0.04)] flex flex-col justify-between min-h-[178px] hover:border-[#dfd7c5] transition-all">
        <div class="flex items-start justify-between">
          <h2 class="text-sm font-normal text-[#574e44]">Total Products</h2>
          <div
            class="w-9 h-9 rounded-full bg-[#f6f2ea] border border-[#eee8db] flex items-center justify-center text-[#5c5246] shrink-0">
            <!-- Book Icon -->
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewbox="0 0 24 24">
              <rect height="16" rx="2" stroke-linecap="round" stroke-linejoin="round" width="14" x="5" y="4"></rect>
              <line stroke-linecap="round" x1="8" x2="16" y1="16" y2="16"></line>
            </svg>
          </div>
        </div>
        <div>
          <div class="text-2xl font-light text-[#221f1c] my-3">—</div>
          <p class="text-xs text-[#8c8072]">Book inventory overview</p>
        </div>
      </div>
      <!-- Metric Card 2: Total Categories -->
      <div
        class="bg-white rounded-2xl p-6 border border-[#ece6d9] shadow-[0_2px_12px_-4px_rgba(40,30,20,0.04)] flex flex-col justify-between min-h-[178px] hover:border-[#dfd7c5] transition-all">
        <div class="flex items-start justify-between">
          <h2 class="text-sm font-normal text-[#574e44]">Total Categories</h2>
          <div
            class="w-9 h-9 rounded-full bg-[#f6f2ea] border border-[#eee8db] flex items-center justify-center text-[#5c5246] shrink-0">
            <!-- 4-Squares Grid Icon -->
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewbox="0 0 24 24">
              <rect height="6" rx="1" width="6" x="4" y="4"></rect>
              <rect height="6" rx="1" width="6" x="14" y="4"></rect>
              <rect height="6" rx="1" width="6" x="4" y="14"></rect>
              <rect height="6" rx="1" width="6" x="14" y="14"></rect>
            </svg>
          </div>
        </div>
        <div>
          <div class="text-2xl font-light text-[#221f1c] my-3">—</div>
          <p class="text-xs text-[#8c8072]">Organized collections</p>
        </div>
      </div>
      <!-- Metric Card 3: Total Orders -->
      <div
        class="bg-white rounded-2xl p-6 border border-[#ece6d9] shadow-[0_2px_12px_-4px_rgba(40,30,20,0.04)] flex flex-col justify-between min-h-[178px] hover:border-[#dfd7c5] transition-all">
        <div class="flex items-start justify-between">
          <h2 class="text-sm font-normal text-[#574e44]">Total Orders</h2>
          <div
            class="w-9 h-9 rounded-full bg-[#f6f2ea] border border-[#eee8db] flex items-center justify-center text-[#5c5246] shrink-0">
            <!-- Shopping Bag Icon -->
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewbox="0 0 24 24">
              <path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" stroke-linecap="round" stroke-linejoin="round">
              </path>
            </svg>
          </div>
        </div>
        <div>
          <div class="text-2xl font-light text-[#221f1c] my-3">—</div>
          <p class="text-xs text-[#8c8072]">Customer purchases</p>
        </div>
      </div>
      <!-- Metric Card 4: Total Customers -->
      <div
        class="bg-white rounded-2xl p-6 border border-[#ece6d9] shadow-[0_2px_12px_-4px_rgba(40,30,20,0.04)] flex flex-col justify-between min-h-[178px] hover:border-[#dfd7c5] transition-all">
        <div class="flex items-start justify-between">
          <h2 class="text-sm font-normal text-[#574e44]">Total Customers</h2>
          <div
            class="w-9 h-9 rounded-full bg-[#f6f2ea] border border-[#eee8db] flex items-center justify-center text-[#5c5246] shrink-0">
            <!-- Customer / Users Icon -->
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewbox="0 0 24 24">
              <path d="M18 19c0-2.21-2.686-4-6-4s-6 1.79-6 4" stroke-linecap="round" stroke-linejoin="round"></path>
              <circle cx="12" cy="9" r="3" stroke-linecap="round" stroke-linejoin="round"></circle>
              <path d="M19 8a2.5 2.5 0 010 5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
        </div>
        <div>
          <div class="text-2xl font-light text-[#221f1c] my-3">—</div>
          <p class="text-xs text-[#8c8072]">Registered accounts</p>
        </div>
      </div>
    </section>
    <!-- END: MetricCardsGrid -->
    <!-- BEGIN: WorkspaceCard -->
    <section
      class="bg-white rounded-2xl p-8 sm:p-10 border border-[#ece6d9] shadow-[0_2px_12px_-4px_rgba(40,30,20,0.04)]"
      data-purpose="workspace-overview">
      <div class="max-w-3xl">
        <!-- Eyebrow -->
        <p class="text-[11px] font-semibold tracking-[0.2em] text-[#8e8274] uppercase mb-2">
          Your Workspace
        </p>
        <!-- Section Headline -->
        <h2 class="font-editorial text-3xl sm:text-4xl text-[#1e1c19] font-normal tracking-tight mb-4">
          Manage your bookstore
        </h2>
        <!-- Descriptive Copy -->
        <p class="text-sm sm:text-base text-[#685e52] leading-relaxed font-normal">
          Use the administration panel to manage books, organize categories, review orders, and oversee customer
          accounts. Dashboard statistics will appear here once connected to the database.
        </p>
      </div>
    </section>
    <!-- END: WorkspaceCard -->
  </main>
  <!-- END: MainContent -->
  <%- include('../partials/admin/footer')%>
</body>

</html>